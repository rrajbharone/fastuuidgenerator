---
interface FaqItem {
  question: string;
  answer: string;
}

interface ArticleMeta {
  publishDate?: Date;
  author?: string;
  category?: string;
}

interface Props {
  title: string;
  description: string;
  url: string;
  faqs?: FaqItem[];
  breadcrumbs?: Array<{ name: string; url: string }>;
  isApp?: boolean;
  articleMeta?: ArticleMeta;
}

const {
  title,
  description,
  url,
  faqs = [],
  breadcrumbs = [],
  isApp = true,
  articleMeta,
} = Astro.props;

const softwareSchema = isApp
  ? {
      '@context': 'https://schema.org',
      '@type': 'WebApplication',
      name: title,
      description: description,
      url: url,
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'Any',
      browserRequirements: 'Requires JavaScript and Web Cryptography API support',
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
      },
    }
  : null;

const blogPostingSchema = articleMeta
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: title.replace(/ \| FastUUIDGenerator Blog$/, ''),
      description: description,
      url: url,
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': url,
      },
      author: {
        '@type': 'Organization',
        name: articleMeta.author || 'FastUUID Engineering Team',
        url: 'https://fastuuidgenerator.com/about/',
      },
      publisher: {
        '@type': 'Organization',
        name: 'FastUUIDGenerator',
        url: 'https://fastuuidgenerator.com',
        logo: {
          '@type': 'ImageObject',
          url: 'https://fastuuidgenerator.com/favicon.svg',
        },
      },
      datePublished: articleMeta.publishDate ? articleMeta.publishDate.toISOString() : undefined,
      articleSection: articleMeta.category,
      inLanguage: 'en',
    }
  : null;

const breadcrumbSchema = breadcrumbs.length > 0
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumbs.map((crumb, idx) => ({
        '@type': 'ListItem',
        position: idx + 1,
        name: crumb.name,
        item: crumb.url,
      })),
    }
  : null;

const faqSchema = faqs.length > 0
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: f.answer,
        },
      })),
    }
  : null;
---

{softwareSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
)}

{blogPostingSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(blogPostingSchema)} />
)}

{breadcrumbSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
)}

{faqSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
)}
