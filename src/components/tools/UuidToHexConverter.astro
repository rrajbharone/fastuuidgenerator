  @media (max-width: 640px) {
    .educational-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
      margin-bottom: 2.5rem;
    }
    .edu-card {
      padding: 1.15rem;
    }
    .edu-card-title {
      font-size: 1.05rem;
    }
    .edu-card-text,
    .edu-steps-list {
      font-size: 0.875rem;
      line-height: 1.6;
    }
    .faq-heading {
      font-size: 1.45rem;
    }
    .faq-question {
      padding: 0.95rem 1rem;
      font-size: 0.925rem;
    }
    .faq-answer {
      padding: 0.75rem 1rem 1rem;
      font-size: 0.875rem;
    }
  }
</style>

<script>
  import {
    uuidToHex,
    hexToUuid,
    generateUUIDv4,
    generateUUIDv7,
    NIL_UUID,
  } from '../../utils/uuid';

  function initUuidToHexTool() {
    // Mode tabs
    const tabUuidToHex = document.getElementById('tab-mode-uuid-to-hex');
    const tabHexToUuid = document.getElementById('tab-mode-hex-to-uuid');
    const panelUuidToHex = document.getElementById('panel-mode-uuid-to-hex');
    const panelHexToUuid = document.getElementById('panel-mode-hex-to-uuid');

    // Tab 1 controls (UUID -> Hex)
    const uuidInput = document.getElementById('uuid-source-input') as HTMLInputElement | null;
    const btnSampleV4 = document.getElementById('btn-sample-uuid-v4');
    const btnSampleV7 = document.getElementById('btn-sample-uuid-v7');
    const btnSampleNil = document.getElementById('btn-sample-uuid-nil');
    const btnClearUuidToHex = document.getElementById('btn-clear-uuid-to-hex');
    const uuidToHexError = document.getElementById('uuid-to-hex-error');
    const uuidToHexResultsBox = document.getElementById('uuid-to-hex-results-box');

    const outRawHex = document.getElementById('out-raw-hex');
    const outUppercaseHex = document.getElementById('out-uppercase-hex');
    const outPrefixedHex = document.getElementById('out-prefixed-hex');
    const outSpacedHex = document.getElementById('out-spaced-hex');

    // Tab 2 controls (Hex -> UUID)
    const hexInput = document.getElementById('hex-source-input') as HTMLInputElement | null;
    const btnSampleHex = document.getElementById('btn-sample-hex');
    const btnSamplePrefixedHex = document.getElementById('btn-sample-prefixed-hex');
    const btnSampleNilHex = document.getElementById('btn-sample-nil-hex');
    const btnClearHexToUuid = document.getElementById('btn-clear-hex-to-uuid');
    const hexToUuidError = document.getElementById('hex-to-uuid-error');
    const hexToUuidResultsBox = document.getElementById('hex-to-uuid-results-box');

    const outCanonicalUuid = document.getElementById('out-canonical-uuid');
    const outUppercaseUuid = document.getElementById('out-uppercase-uuid');
    const outHexNormalized = document.getElementById('out-hex-normalized');

    if (!tabUuidToHex || !tabHexToUuid) return;

    // Tab Switching
    tabUuidToHex.addEventListener('click', () => {
      tabUuidToHex.classList.add('active');
      tabUuidToHex.setAttribute('aria-selected', 'true');
      tabHexToUuid.classList.remove('active');
      tabHexToUuid.setAttribute('aria-selected', 'false');

      if (panelUuidToHex) panelUuidToHex.style.display = 'block';
      if (panelHexToUuid) panelHexToUuid.style.display = 'none';
    });

    tabHexToUuid.addEventListener('click', () => {
      tabHexToUuid.classList.add('active');
      tabHexToUuid.setAttribute('aria-selected', 'true');
      tabUuidToHex.classList.remove('active');
      tabUuidToHex.setAttribute('aria-selected', 'false');

      if (panelHexToUuid) panelHexToUuid.style.display = 'block';
      if (panelUuidToHex) panelUuidToHex.style.display = 'none';
    });

    // Copy Handler Helper
    document.querySelectorAll('.copy-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-target');
        if (!targetId) return;
        const targetEl = document.getElementById(targetId);
        if (!targetEl) return;
        const text = (targetEl.textContent || '').trim();
        if (!text) return;

        navigator.clipboard.writeText(text).then(() => {
          const label = btn.querySelector('.copy-label');
          if (label) {
            const prev = label.textContent;
            label.textContent = 'Copied!';
            setTimeout(() => {
              label.textContent = prev;
            }, 1500);
          }
        });
      });
    });

    // Process UUID -> Hex
    function processUuidToHex(val: string) {
      const trimmed = val.trim();
      if (!trimmed) {
        if (uuidToHexError) uuidToHexError.style.display = 'none';
        if (uuidToHexResultsBox) uuidToHexResultsBox.style.display = 'none';
        return;
      }

      const res = uuidToHex(trimmed);
      if (!res.isValid) {
        if (uuidToHexError) {
          uuidToHexError.textContent = res.error || 'Invalid UUID format';
          uuidToHexError.style.display = 'block';
        }
        if (uuidToHexResultsBox) uuidToHexResultsBox.style.display = 'none';
        return;
      }

      if (uuidToHexError) uuidToHexError.style.display = 'none';
      if (uuidToHexResultsBox) uuidToHexResultsBox.style.display = 'block';

      if (outRawHex) outRawHex.textContent = res.rawHex;
      if (outUppercaseHex) outUppercaseHex.textContent = res.uppercaseHex;
      if (outPrefixedHex) outPrefixedHex.textContent = res.prefixedHex;
      if (outSpacedHex) outSpacedHex.textContent = res.spacedHex;
    }

    if (uuidInput) {
      uuidInput.addEventListener('input', () => {
        processUuidToHex(uuidInput.value);
      });
    }

    if (btnSampleV4) {
      btnSampleV4.addEventListener('click', () => {
        const v4 = generateUUIDv4();
        if (uuidInput) {
          uuidInput.value = v4;
          processUuidToHex(v4);
        }
      });
    }

    if (btnSampleV7) {
      btnSampleV7.addEventListener('click', () => {
        const v7 = generateUUIDv7();
        if (uuidInput) {
          uuidInput.value = v7;
          processUuidToHex(v7);
        }
      });
    }

    if (btnSampleNil) {
      btnSampleNil.addEventListener('click', () => {
        if (uuidInput) {
          uuidInput.value = NIL_UUID;
          processUuidToHex(NIL_UUID);
        }
      });
    }

    if (btnClearUuidToHex) {
      btnClearUuidToHex.addEventListener('click', () => {
        if (uuidInput) {
          uuidInput.value = '';
          processUuidToHex('');
        }
      });
    }

    // Process Hex -> UUID
    function processHexToUuid(val: string) {
      const trimmed = val.trim();
      if (!trimmed) {
        if (hexToUuidError) hexToUuidError.style.display = 'none';
        if (hexToUuidResultsBox) hexToUuidResultsBox.style.display = 'none';
        return;
      }

      const res = hexToUuid(trimmed);
      if (!res.isValid) {
        if (hexToUuidError) {
          hexToUuidError.textContent = res.error || 'Invalid hexadecimal sequence';
          hexToUuidError.style.display = 'block';
        }
        if (hexToUuidResultsBox) hexToUuidResultsBox.style.display = 'none';
        return;
      }

      if (hexToUuidError) hexToUuidError.style.display = 'none';
      if (hexToUuidResultsBox) hexToUuidResultsBox.style.display = 'block';

      if (outCanonicalUuid) outCanonicalUuid.textContent = res.canonicalUuid;
      if (outUppercaseUuid) outUppercaseUuid.textContent = res.uppercaseUuid;
      if (outHexNormalized) outHexNormalized.textContent = res.rawHex;
    }

    if (hexInput) {
      hexInput.addEventListener('input', () => {
        processHexToUuid(hexInput.value);
      });
    }

    if (btnSampleHex) {
      btnSampleHex.addEventListener('click', () => {
        const sampleHex = '550e8400e29b41d4a716446655440000';
        if (hexInput) {
          hexInput.value = sampleHex;
          processHexToUuid(sampleHex);
        }
      });
    }

    if (btnSamplePrefixedHex) {
      btnSamplePrefixedHex.addEventListener('click', () => {
        const sample0x = '0x550e8400e29b41d4a716446655440000';
        if (hexInput) {
          hexInput.value = sample0x;
          processHexToUuid(sample0x);
        }
      });
    }

    if (btnSampleNilHex) {
      btnSampleNilHex.addEventListener('click', () => {
        const nilHex = '00000000000000000000000000000000';
        if (hexInput) {
          hexInput.value = nilHex;
          processHexToUuid(nilHex);
        }
      });
    }

    if (btnClearHexToUuid) {
      btnClearHexToUuid.addEventListener('click', () => {
        if (hexInput) {
          hexInput.value = '';
          processHexToUuid('');
        }
      });
    }

    // Initialize with preset value if present
    if (uuidInput && uuidInput.value) {
      processUuidToHex(uuidInput.value);
    }
  }

  initUuidToHexTool();
  document.addEventListener('astro:page-load', initUuidToHexTool);
</script>
