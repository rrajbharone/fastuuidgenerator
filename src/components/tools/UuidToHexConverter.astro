  /* FAQ Section */
  .faq-section-wrapper {
    margin-top: 1rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border-glass);
    width: 100%;
    box-sizing: border-box;
  }

  .faq-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 2rem;
    padding: 0 0.5rem;
  }

  .faq-heading {
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
    overflow-wrap: break-word;
    word-break: break-word;
  }

  .faq-subheading {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.5;
    overflow-wrap: break-word;
    word-break: break-word;
  }

  .faq-accordion-list {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    max-width: 800px;
    margin: 0 auto;
    width: 100%;
    box-sizing: border-box;
  }

  .faq-item {
    background: var(--bg-glass);
    border: 1px solid var(--border-glass);
    border-radius: var(--radius-md);
    padding: 0;
    transition: border-color 0.15s ease;
    overflow: hidden;
    box-sizing: border-box;
  }

  .faq-item:hover {
