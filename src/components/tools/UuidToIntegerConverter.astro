  @media (max-width: 640px) {
    .educational-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
      margin-bottom: 2.5rem;
    }
    .edu-card {
      padding: 1.15rem;
    }
    .edu-card-title {
      font-size: 1.05rem;
    }
    .edu-card-text,
    .edu-steps-list {
      font-size: 0.875rem;
      line-height: 1.6;
    }
