      padding: 0.95rem 1rem;
      font-size: 0.925rem;
    }
    .faq-answer {
      padding: 0.75rem 1rem 1rem;
      font-size: 0.875rem;
    }
  }
</style>

<script>
  import {
    uuidToInteger,
    integerToUuid,
    formatIntegerWithCommas,
    generateUUIDv4,
    generateUUIDv7,
    MAX_UUID_BIGINT,
  } from '../../utils/uuid';

  function initUuidToIntegerTool() {
    // Mode tabs
    const tabUuidToInt = document.getElementById('tab-mode-uuid-to-int');
    const tabIntToUuid = document.getElementById('tab-mode-int-to-uuid');
    const panelUuidToInt = document.getElementById('panel-mode-uuid-to-int');
    const panelIntToUuid = document.getElementById('panel-mode-int-to-uuid');

    // Tab 1 controls
    const uuidInput = document.getElementById('uuid-source-input') as HTMLInputElement | null;
    const btnSampleV4 = document.getElementById('btn-sample-uuid-v4');
    const btnSampleV7 = document.getElementById('btn-sample-uuid-v7');
    const btnClearUuidToInt = document.getElementById('btn-clear-uuid-to-int');
    const uuidToIntError = document.getElementById('uuid-to-int-error');
    const uuidToIntResultsBox = document.getElementById('uuid-to-int-results-box');

    const outRawInteger = document.getElementById('out-raw-integer');
    const outFormattedInteger = document.getElementById('out-formatted-integer');
    const outRawHex = document.getElementById('out-raw-hex');
    const digitsBadge = document.getElementById('uuid-digits-badge');

    // Tab 2 controls
    const integerInput = document.getElementById('integer-source-input') as HTMLInputElement | null;
    const btnSampleInteger = document.getElementById('btn-sample-integer');
    const btnSampleMaxInteger = document.getElementById('btn-sample-max-integer');
    const btnClearIntToUuid = document.getElementById('btn-clear-int-to-uuid');
    const intToUuidError = document.getElementById('int-to-uuid-error');
    const intToUuidResultsBox = document.getElementById('int-to-uuid-results-box');

    const outCanonicalUuid = document.getElementById('out-canonical-uuid');
    const outUppercaseUuid = document.getElementById('out-uppercase-uuid');
    const outIntHex = document.getElementById('out-int-hex');

    if (!tabUuidToInt || !tabIntToUuid) return;

    // Tab Switching
    tabUuidToInt.addEventListener('click', () => {
      tabUuidToInt.classList.add('active');
      tabUuidToInt.setAttribute('aria-selected', 'true');
      tabIntToUuid.classList.remove('active');
      tabIntToUuid.setAttribute('aria-selected', 'false');

      if (panelUuidToInt) panelUuidToInt.style.display = 'block';
      if (panelIntToUuid) panelIntToUuid.style.display = 'none';
    });

    tabIntToUuid.addEventListener('click', () => {
      tabIntToUuid.classList.add('active');
      tabIntToUuid.setAttribute('aria-selected', 'true');
      tabUuidToInt.classList.remove('active');
      tabUuidToInt.setAttribute('aria-selected', 'false');

      if (panelIntToUuid) panelIntToUuid.style.display = 'block';
      if (panelUuidToInt) panelUuidToInt.style.display = 'none';
    });

    // Copy Handler Helper
    // CRITICAL: When copying from an element like out-raw-integer, it copies exact unformatted digits.
    document.querySelectorAll('.copy-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-target');
        if (!targetId) return;
        const targetEl = document.getElementById(targetId);
        if (!targetEl) return;
        const text = (targetEl.textContent || '').trim();
        if (!text) return;

        navigator.clipboard.writeText(text).then(() => {
          const label = btn.querySelector('.copy-label');
          if (label) {
            const prev = label.textContent;
            label.textContent = 'Copied!';
            setTimeout(() => {
              label.textContent = prev;
            }, 1500);
          }
        });
      });
    });

    // Process UUID -> Integer
    function processUuidToInt(val: string) {
      const trimmed = val.trim();
      if (!trimmed) {
        if (uuidToIntError) uuidToIntError.style.display = 'none';
        if (uuidToIntResultsBox) uuidToIntResultsBox.style.display = 'none';
        return;
      }

      const res = uuidToInteger(trimmed);
      if (!res.isValid) {
        if (uuidToIntError) {
          uuidToIntError.textContent = res.error || 'Invalid UUID format';
          uuidToIntError.style.display = 'block';
        }
        if (uuidToIntResultsBox) uuidToIntResultsBox.style.display = 'none';
        return;
      }

      if (uuidToIntError) uuidToIntError.style.display = 'none';
      if (uuidToIntResultsBox) uuidToIntResultsBox.style.display = 'block';

      if (outRawInteger) outRawInteger.textContent = res.rawInteger;
      if (outFormattedInteger) outFormattedInteger.textContent = res.formattedInteger;
      if (outRawHex) outRawHex.textContent = res.rawHex;
      if (digitsBadge) digitsBadge.textContent = `${res.rawInteger.length} digits`;
    }

    if (uuidInput) {
      uuidInput.addEventListener('input', () => {
        processUuidToInt(uuidInput.value);
      });
    }

    if (btnSampleV4) {
      btnSampleV4.addEventListener('click', () => {
        const v4 = generateUUIDv4();
        if (uuidInput) {
          uuidInput.value = v4;
          processUuidToInt(v4);
        }
      });
    }

    if (btnSampleV7) {
      btnSampleV7.addEventListener('click', () => {
        const v7 = generateUUIDv7();
        if (uuidInput) {
          uuidInput.value = v7;
          processUuidToInt(v7);
        }
      });
    }

    if (btnClearUuidToInt) {
      btnClearUuidToInt.addEventListener('click', () => {
        if (uuidInput) {
          uuidInput.value = '';
          processUuidToInt('');
        }
      });
    }

    // Process Integer -> UUID
    function processIntToUuid(val: string) {
      const trimmed = val.trim();
      if (!trimmed) {
        if (intToUuidError) intToUuidError.style.display = 'none';
        if (intToUuidResultsBox) intToUuidResultsBox.style.display = 'none';
        return;
      }

      const res = integerToUuid(trimmed);
      if (!res.isValid) {
        if (intToUuidError) {
          intToUuidError.textContent = res.error || 'Invalid integer';
          intToUuidError.style.display = 'block';
        }
        if (intToUuidResultsBox) intToUuidResultsBox.style.display = 'none';
        return;
      }

      if (intToUuidError) intToUuidError.style.display = 'none';
      if (intToUuidResultsBox) intToUuidResultsBox.style.display = 'block';

      if (outCanonicalUuid) outCanonicalUuid.textContent = res.canonicalUuid;
      if (outUppercaseUuid) outUppercaseUuid.textContent = res.canonicalUuid.toUpperCase();
      if (outIntHex) outIntHex.textContent = res.rawHex;
    }

    if (integerInput) {
      integerInput.addEventListener('input', () => {
        processIntToUuid(integerInput.value);
      });
    }

    if (btnSampleInteger) {
      btnSampleInteger.addEventListener('click', () => {
        const sampleVal = '113059749145936325402354257176981405696';
        if (integerInput) {
          integerInput.value = sampleVal;
          processIntToUuid(sampleVal);
        }
      });
    }

    if (btnSampleMaxInteger) {
      btnSampleMaxInteger.addEventListener('click', () => {
        const maxVal = MAX_UUID_BIGINT.toString();
        if (integerInput) {
          integerInput.value = maxVal;
          processIntToUuid(maxVal);
        }
      });
    }

    if (btnClearIntToUuid) {
      btnClearIntToUuid.addEventListener('click', () => {
        if (integerInput) {
          integerInput.value = '';
          processIntToUuid('');
        }
      });
    }

    // Initialize with preset value if present
    if (uuidInput && uuidInput.value) {
      processUuidToInt(uuidInput.value);
    }
  }

  initUuidToIntegerTool();
  document.addEventListener('astro:page-load', initUuidToIntegerTool);
</script>
