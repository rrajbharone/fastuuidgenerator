---
import type { TranslationDictionary } from '../../i18n/schema';
import type { LanguageCode } from '../../i18n/languages';
import {
  generateUUIDv5,
  NAMESPACE_DNS,
  NAMESPACE_URL,
  NAMESPACE_OID,
  NAMESPACE_X500,
} from '../../utils/uuid';

interface Props {
  t: TranslationDictionary;
  lang: LanguageCode;
}

const { t, lang } = Astro.props;

// Initial sample generation (RFC 4122 Appendix B test vector: DNS + python.org)
const initialNamespace = NAMESPACE_DNS;
const initialName = 'python.org';
const initialRes = generateUUIDv5(initialNamespace, initialName);
---

<div class="glass-panel tool-card" id="uuid-v5-generator-tool">
  <!-- Top Action & Preset Bar -->
  <div class="tool-controls-bar">
    <div class="control-left">
      <span class="control-label">
        {t.uuidV5Generator.inputCardTitle}
      </span>
    </div>

    <div class="action-buttons-group">
      <button type="button" class="btn btn-secondary btn-sm preset-btn active" id="btn-preset-dns" data-namespace={NAMESPACE_DNS} title="DNS Namespace">
        <span>{t.uuidV5Generator.presetDns}</span>
      </button>

      <button type="button" class="btn btn-secondary btn-sm preset-btn" id="btn-preset-url" data-namespace={NAMESPACE_URL} title="URL Namespace">
        <span>{t.uuidV5Generator.presetUrl}</span>
      </button>

      <button type="button" class="btn btn-secondary btn-sm preset-btn" id="btn-preset-oid" data-namespace={NAMESPACE_OID} title="OID Namespace">
        <span>{t.uuidV5Generator.presetOid}</span>
      </button>

      <button type="button" class="btn btn-secondary btn-sm preset-btn" id="btn-preset-x500" data-namespace={NAMESPACE_X500} title="X.500 Namespace">
        <span>{t.uuidV5Generator.presetX500}</span>
      </button>

      <button type="button" class="btn btn-secondary btn-sm preset-btn" id="btn-preset-custom" title="Custom Namespace">
        <span>{t.uuidV5Generator.presetCustom}</span>
      </button>

      <button type="button" class="btn btn-outline btn-sm" id="btn-v5-clear" title="Clear inputs">
        <span>{t.uuidV5Generator.clearButton}</span>
      </button>
    </div>
  </div>

  <!-- Primary Inputs -->
  <div class="inputs-container">
    <!-- 1. Namespace UUID Field -->
    <div class="input-field-group">
      <label for="v5-namespace-input" class="control-label">
        {t.uuidV5Generator.namespaceLabel}
      </label>
      <input
        type="text"
        id="v5-namespace-input"
        class="input-control input-mono"
        placeholder={t.uuidV5Generator.namespacePlaceholder}
        value={initialNamespace}
        spellcheck="false"
        autocomplete="off"
      />
      <div id="v5-namespace-error" class="inline-error-msg" style="display: none;">
        {t.uuidV5Generator.invalidNamespaceError}
      </div>
    </div>

    <!-- 2. Name / String Field -->
    <div class="input-field-group">
      <label for="v5-name-input" class="control-label">
        {t.uuidV5Generator.nameLabel}
      </label>
      <input
        type="text"
        id="v5-name-input"
        class="input-control input-mono"
        placeholder={t.uuidV5Generator.namePlaceholder}
        value={initialName}
        spellcheck="false"
        autocomplete="off"
      />
      <div id="v5-empty-warning" class="inline-warning-msg" style="display: none;">
        {t.uuidV5Generator.emptyNameWarning}
      </div>
    </div>

    <!-- 3. Action Button & Deterministic Guarantee Notice -->
    <div class="generate-action-bar">
      <button type="button" class="btn btn-primary" id="btn-v5-generate">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
          <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
          <line x1="12" y1="22.08" x2="12" y2="12"></line>
        </svg>
        <span>{t.uuidV5Generator.generateButton}</span>
      </button>
      <p class="deterministic-notice">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <path d="m9 12 2 2 4-4"></path>
        </svg>
        <span>{t.uuidV5Generator.deterministicNotice}</span>
      </p>
    </div>
  </div>

  <!-- Output Results Section -->
  <div class="results-container" id="v5-results-container">
    <div class="results-header-row">
      <div class="badges-group">
        <span class="badge badge-brand">{t.uuidV5Generator.resultsLabel}</span>
        <span class="badge badge-success">{t.uuidV5Generator.versionBadge}</span>
        <span class="badge badge-neutral">{t.uuidV5Generator.variantBadge}</span>
      </div>
      <span class="privacy-note">{t.common.privacyNotice}</span>
    </div>

    <div class="outputs-stack">
      <!-- 1. Canonical Lowercase UUID (Primary) -->
      <div class="output-card highlight-card">
        <div class="output-meta">
          <div class="output-title-group">
            <span class="output-title">{t.uuidV5Generator.canonicalUuidLabel}</span>
            <span class="badge badge-brand">RFC 9562 §5.5 Standard</span>
          </div>
          <button type="button" class="btn btn-secondary btn-sm copy-btn" data-target="out-v5-canonical" aria-label={t.uuidV5Generator.copyButton}>
            <span class="copy-label">{t.uuidV5Generator.copyButton}</span>
          </button>
        </div>
        <div class="output-value-box">
          <code class="output-text input-mono" id="out-v5-canonical">{initialRes.uuid}</code>
        </div>
      </div>

      <!-- 2. Uppercase UUID -->
      <div class="output-card">
        <div class="output-meta">
          <div class="output-title-group">
            <span class="output-title">{t.uuidV5Generator.uppercaseUuidLabel}</span>
            <span class="badge badge-neutral">Windows / C# Compatible</span>
          </div>
          <button type="button" class="btn btn-secondary btn-sm copy-btn" data-target="out-v5-uppercase" aria-label={t.uuidV5Generator.copyButton}>
            <span class="copy-label">{t.uuidV5Generator.copyButton}</span>
          </button>
        </div>
        <div class="output-value-box">
          <code class="output-text input-mono" id="out-v5-uppercase">{initialRes.uppercaseUuid}</code>
        </div>
      </div>

      <!-- 3. Raw 160-bit SHA-1 Digest -->
      <div class="output-card">
        <div class="output-meta">
          <div class="output-title-group">
            <span class="output-title">{t.uuidV5Generator.sha1DigestLabel}</span>
            <span class="badge badge-neutral">Full 20-Byte Hex Digest</span>
          </div>
          <button type="button" class="btn btn-secondary btn-sm copy-btn" data-target="out-v5-sha1" aria-label={t.uuidV5Generator.copyButton}>
            <span class="copy-label">{t.uuidV5Generator.copyButton}</span>
          </button>
        </div>
        <div class="output-value-box">
          <code class="output-text input-mono" id="out-v5-sha1">{initialRes.sha1DigestHex}</code>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Educational Technical Article Content (Clean normal layout, NOT cards) -->
<article class="technical-article" id="article-uuid-v5">
  <header class="article-header">
    <h2 class="article-title">{t.uuidV5Generator.whatIsTitle}</h2>
  </header>

  <section class="article-body">
    <p class="article-lead">{t.uuidV5Generator.whatIsContent}</p>

    <h2>{t.uuidV5Generator.howItWorksTitle}</h2>
    <p>{t.uuidV5Generator.howItWorksContent}</p>

    <h2>{t.uuidV5Generator.namespacesTitle}</h2>
    <p>{t.uuidV5Generator.namespacesContent}</p>

    <h2>{t.uuidV5Generator.howToGenerateTitle}</h2>
    <p>{t.uuidV5Generator.howToGenerateContent}</p>

    <h2>{t.uuidV5Generator.verifiedExampleTitle}</h2>
    <p>{t.uuidV5Generator.verifiedExampleContent}</p>

    <h2>{t.uuidV5Generator.v5VsV4Title}</h2>
    <p>{t.uuidV5Generator.v5VsV4Content}</p>

    <h2>{t.uuidV5Generator.v5VsV3Title}</h2>
    <p>{t.uuidV5Generator.v5VsV3Content}</p>

    <h2>{t.uuidV5Generator.securityTitle}</h2>
    <p>{t.uuidV5Generator.securityContent}</p>

    <h2>{t.uuidV5Generator.useCasesTitle}</h2>
    <p>{t.uuidV5Generator.useCasesContent}</p>

    <h2>{t.uuidV5Generator.faqTitle}</h2>
    <div class="faq-container">
      {t.uuidV5Generator.faqs.map((faq, index) => (
        <details class="faq-item" id={`uuid-v5-faq-${index + 1}`}>
          <summary class="faq-question">
            <span>{faq.question}</span>
            <svg class="faq-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </summary>
          <div class="faq-answer">
            <p>{faq.answer}</p>
          </div>
        </details>
      ))}
    </div>
  </section>
</article>

<style>
  .tool-card {
    padding: 1.75rem;
    margin-bottom: 3rem;
  }

  .tool-controls-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .control-label {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .action-buttons-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
  }

  .preset-btn.active {
    background: var(--brand-primary);
    color: #ffffff !important;
    border-color: var(--brand-primary);
  }

  .inputs-container {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-bottom: 2rem;
  }

  .input-field-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .generate-action-bar {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
    margin-top: 0.5rem;
  }

  .deterministic-notice {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin: 0;
    line-height: 1.4;
    flex: 1;
    min-width: 240px;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .deterministic-notice svg {
    color: var(--brand-primary);
    flex-shrink: 0;
  }

  .inline-error-msg {
    color: #ef4444;
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.4;
    padding: 0.5rem 0.75rem;
    background: rgba(239, 68, 68, 0.1);
    border: 1px solid rgba(239, 68, 68, 0.3);
    border-radius: var(--radius-sm);
    margin-top: 0.25rem;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .inline-warning-msg {
    color: #f59e0b;
    font-size: 0.85rem;
    font-weight: 500;
    line-height: 1.4;
    padding: 0.4rem 0.75rem;
    background: rgba(245, 158, 11, 0.1);
    border: 1px solid rgba(245, 158, 11, 0.3);
    border-radius: var(--radius-sm);
    margin-top: 0.25rem;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  /* Results Section */
  .results-container {
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-subtle);
  }

  .results-header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .badges-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .privacy-note {
    font-size: 0.8rem;
    color: var(--text-tertiary);
  }

  .outputs-stack {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .output-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 1.15rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    transition: border-color 0.15s ease;
    min-width: 0;
  }

  .output-card.highlight-card {
    border-color: var(--brand-glow);
    background: var(--bg-glass);
    box-shadow: 0 4px 12px rgba(99, 102, 241, 0.05);
  }

  .output-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .output-title-group {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .output-title {
    font-size: 0.925rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .output-value-box {
    background: var(--bg-tertiary);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: 0.85rem 1rem;
    overflow-x: auto;
    display: flex;
    align-items: center;
  }

  .output-text {
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--text-primary);
    white-space: pre-wrap;
    word-break: break-all;
    overflow-wrap: anywhere;
    user-select: all;
  }

  .highlight-card .output-text {
    color: var(--brand-primary);
    font-size: 1.15rem;
  }

  @media (max-width: 768px) {
    .tool-card {
      padding: 1.25rem;
    }
  }
</style>

<script>
  import {
    generateUUIDv5,
    NAMESPACE_DNS,
    NAMESPACE_URL,
    NAMESPACE_OID,
    NAMESPACE_X500,
  } from '../../utils/uuid';

  function initUuidV5GeneratorTool() {
    const namespaceInput = document.getElementById('v5-namespace-input') as HTMLInputElement | null;
    const nameInput = document.getElementById('v5-name-input') as HTMLInputElement | null;
    const btnGenerate = document.getElementById('btn-v5-generate');
    const btnClear = document.getElementById('btn-v5-clear');
    const namespaceError = document.getElementById('v5-namespace-error');
    const emptyWarning = document.getElementById('v5-empty-warning');

    const outCanonical = document.getElementById('out-v5-canonical');
    const outUppercase = document.getElementById('out-v5-uppercase');
    const outSha1 = document.getElementById('out-v5-sha1');

    const presetDns = document.getElementById('btn-preset-dns');
    const presetUrl = document.getElementById('btn-preset-url');
    const presetOid = document.getElementById('btn-preset-oid');
    const presetX500 = document.getElementById('btn-preset-x500');
    const presetCustom = document.getElementById('btn-preset-custom');

    const presetButtons = [presetDns, presetUrl, presetOid, presetX500, presetCustom];

    function setActivePreset(activeBtn: HTMLElement | null) {
      presetButtons.forEach(btn => {
        if (btn) {
          if (btn === activeBtn) {
            btn.classList.add('active');
          } else {
            btn.classList.remove('active');
          }
        }
      });
    }

    function checkActivePreset(currentNamespace: string) {
      const clean = currentNamespace.trim().toLowerCase();
      if (clean === NAMESPACE_DNS) {
        setActivePreset(presetDns);
      } else if (clean === NAMESPACE_URL) {
        setActivePreset(presetUrl);
      } else if (clean === NAMESPACE_OID) {
        setActivePreset(presetOid);
      } else if (clean === NAMESPACE_X500) {
        setActivePreset(presetX500);
      } else {
        setActivePreset(presetCustom);
      }
    }

    function performGeneration() {
      if (!namespaceInput || !nameInput) return;

      const nsVal = namespaceInput.value.trim();
      const nameVal = nameInput.value;

      if (nameVal.length === 0) {
        if (emptyWarning) emptyWarning.style.display = 'block';
      } else {
        if (emptyWarning) emptyWarning.style.display = 'none';
      }

      const res = generateUUIDv5(nsVal, nameVal);

      if (!res.isValid) {
        if (namespaceError) namespaceError.style.display = 'block';
        if (outCanonical) outCanonical.textContent = '—';
        if (outUppercase) outUppercase.textContent = '—';
        if (outSha1) outSha1.textContent = '—';
        return;
      }

      if (namespaceError) namespaceError.style.display = 'none';
      if (outCanonical) outCanonical.textContent = res.uuid;
      if (outUppercase) outUppercase.textContent = res.uppercaseUuid;
      if (outSha1) outSha1.textContent = res.sha1DigestHex;

      checkActivePreset(nsVal);
    }

    // Event Listeners
    if (btnGenerate) {
      btnGenerate.addEventListener('click', performGeneration);
    }

    if (namespaceInput) {
      namespaceInput.addEventListener('input', () => {
        checkActivePreset(namespaceInput.value);
        performGeneration();
      });
    }

    if (nameInput) {
      nameInput.addEventListener('input', performGeneration);
    }

    if (btnClear) {
      btnClear.addEventListener('click', () => {
        if (namespaceInput) namespaceInput.value = '';
        if (nameInput) nameInput.value = '';
        if (namespaceError) namespaceError.style.display = 'none';
        if (emptyWarning) emptyWarning.style.display = 'none';
        if (outCanonical) outCanonical.textContent = '—';
        if (outUppercase) outUppercase.textContent = '—';
        if (outSha1) outSha1.textContent = '—';
        setActivePreset(presetCustom);
        if (nameInput) nameInput.focus();
      });
    }

    // Preset Clicks
    if (presetDns) {
      presetDns.addEventListener('click', () => {
        if (namespaceInput) {
          namespaceInput.value = NAMESPACE_DNS;
          setActivePreset(presetDns);
          performGeneration();
        }
      });
    }

    if (presetUrl) {
      presetUrl.addEventListener('click', () => {
        if (namespaceInput) {
          namespaceInput.value = NAMESPACE_URL;
          setActivePreset(presetUrl);
          performGeneration();
        }
      });
    }

    if (presetOid) {
      presetOid.addEventListener('click', () => {
        if (namespaceInput) {
          namespaceInput.value = NAMESPACE_OID;
          setActivePreset(presetOid);
          performGeneration();
        }
      });
    }

    if (presetX500) {
      presetX500.addEventListener('click', () => {
        if (namespaceInput) {
          namespaceInput.value = NAMESPACE_X500;
          setActivePreset(presetX500);
          performGeneration();
        }
      });
    }

    if (presetCustom) {
      presetCustom.addEventListener('click', () => {
        setActivePreset(presetCustom);
        if (namespaceInput) {
          namespaceInput.focus();
          namespaceInput.select();
        }
      });
    }

    // Copy Buttons Handlers
    document.querySelectorAll('.copy-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const targetId = btn.getAttribute('data-target');
        if (!targetId) return;

        const targetEl = document.getElementById(targetId);
        if (!targetEl || !targetEl.textContent || targetEl.textContent === '—') return;

        try {
          await navigator.clipboard.writeText(targetEl.textContent);
          const labelSpan = btn.querySelector('.copy-label');
          if (labelSpan) {
            const originalText = labelSpan.textContent;
            labelSpan.textContent = 'Copied!';
            setTimeout(() => {
              labelSpan.textContent = originalText;
            }, 2000);
          }
        } catch (err) {
          console.error('Failed to copy to clipboard', err);
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initUuidV5GeneratorTool);
  } else {
    initUuidV5GeneratorTool();
  }
</script>
