</style>

<script>
  import { generateUUIDv8 } from '../../utils/uuid';

  function initUuidV8Tool() {
    const btnModeRandom = document.getElementById('btn-mode-random');
    const btnModeCustom = document.getElementById('btn-mode-custom');
    const customContainer = document.getElementById('v8-custom-container');
    const customHexInput = document.getElementById('v8-custom-hex-input') as HTMLInputElement | null;
    const hexCounter = document.getElementById('v8-hex-counter');
    const hexError = document.getElementById('v8-hex-error');

    const btnPresetTimestamp = document.getElementById('btn-preset-timestamp');
    const btnPresetDevice = document.getElementById('btn-preset-device');
    const btnPresetMax = document.getElementById('btn-preset-max');

    const btnGenerate = document.getElementById('btn-v8-generate');
    const btnClear = document.getElementById('btn-v8-clear');

    const outCanonical = document.getElementById('out-v8-canonical');
    const outUppercase = document.getElementById('out-v8-uppercase');
    const outRaw = document.getElementById('out-v8-raw');
    const outUrn = document.getElementById('out-v8-urn');
    const outCustomA = document.getElementById('out-v8-custom-a');
    const outVer = document.getElementById('out-v8-ver');
    const outCustomB = document.getElementById('out-v8-custom-b');
    const outVar = document.getElementById('out-v8-var');
    const outCustomC = document.getElementById('out-v8-custom-c');
    const outBinary = document.getElementById('out-v8-binary');

    let currentMode: 'random' | 'custom' = 'random';

    function setMode(mode: 'random' | 'custom') {
      currentMode = mode;
      if (mode === 'random') {
        btnModeRandom?.classList.add('active');
        btnModeRandom?.setAttribute('aria-pressed', 'true');
        btnModeCustom?.classList.remove('active');
        btnModeCustom?.setAttribute('aria-pressed', 'false');
        if (customContainer) customContainer.style.display = 'none';
        if (hexError) hexError.style.display = 'none';
      } else {
        btnModeCustom?.classList.add('active');
        btnModeCustom?.setAttribute('aria-pressed', 'true');
        btnModeRandom?.classList.remove('active');
        btnModeRandom?.setAttribute('aria-pressed', 'false');
        if (customContainer) customContainer.style.display = 'flex';
        customHexInput?.focus();
      }
    }

    btnModeRandom?.addEventListener('click', () => {
      setMode('random');
      runGeneration();
    });

    btnModeCustom?.addEventListener('click', () => {
      setMode('custom');
      runGeneration();
    });

    // Update hex character counter
    customHexInput?.addEventListener('input', () => {
      const len = customHexInput.value.length;
      if (hexCounter) {
        hexCounter.textContent = `${len} / 32 hex chars`;
      }
      if (hexError) {
        hexError.style.display = 'none';
      }
    });

    // Presets
    btnPresetTimestamp?.addEventListener('click', () => {
      const tsHex = Date.now().toString(16).padStart(12, '0');
      if (customHexInput) {
        customHexInput.value = tsHex;
        if (hexCounter) hexCounter.textContent = `${tsHex.length} / 32 hex chars`;
      }
      runGeneration();
    });

    btnPresetDevice?.addEventListener('click', () => {
      const deviceHex = '001122334455';
      if (customHexInput) {
        customHexInput.value = deviceHex;
        if (hexCounter) hexCounter.textContent = `${deviceHex.length} / 32 hex chars`;
      }
      runGeneration();
    });

    btnPresetMax?.addEventListener('click', () => {
      const maxHex = 'ffffffffffffffffffffffffffffffff';
      if (customHexInput) {
        customHexInput.value = maxHex;
        if (hexCounter) hexCounter.textContent = `${maxHex.length} / 32 hex chars`;
      }
      runGeneration();
    });

    function getPaddingStrategy(): 'zero' | 'random' {
      const radio = document.querySelector('input[name="v8-padding"]:checked') as HTMLInputElement | null;
      return (radio?.value as 'zero' | 'random') || 'zero';
    }

    function runGeneration() {
      try {
        if (hexError) hexError.style.display = 'none';

        let res;
        if (currentMode === 'random') {
          res = generateUUIDv8({ mode: 'random' });
        } else {
          const rawInput = customHexInput?.value || '';
          const padding = getPaddingStrategy();
          res = generateUUIDv8({
            mode: 'custom',
            customHex: rawInput,
            paddingStrategy: padding,
          });
        }

        if (outCanonical) outCanonical.textContent = res.uuid;
        if (outUppercase) outUppercase.textContent = res.uuid.toUpperCase();
        if (outRaw) outRaw.textContent = res.rawHex;
        if (outUrn) outUrn.textContent = `urn:uuid:${res.uuid}`;
        if (outCustomA) outCustomA.textContent = res.customA;
        if (outVer) outVer.textContent = res.versionNibble;
        if (outCustomB) outCustomB.textContent = res.customB;
        if (outVar) outVar.textContent = res.variantNibble;
        if (outCustomC) outCustomC.textContent = res.customC;
        if (outBinary) outBinary.textContent = res.binary;
      } catch (err: any) {
        if (hexError) {
          hexError.textContent = err.message || 'Invalid input';
          hexError.style.display = 'block';
        }
      }
    }

    btnGenerate?.addEventListener('click', runGeneration);

    btnClear?.addEventListener('click', () => {
      if (customHexInput) {
        customHexInput.value = '';
        if (hexCounter) hexCounter.textContent = '0 / 32 hex chars';
      }
      if (hexError) hexError.style.display = 'none';
      setMode('random');
      runGeneration();
    });

    // Copy functionality
    const copyButtons = document.querySelectorAll('#uuid-v8-generator-tool .copy-btn');
    copyButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-target');
        if (!targetId) return;
        const targetElem = document.getElementById(targetId);
        if (!targetElem) return;

        const textToCopy = targetElem.textContent || '';
        navigator.clipboard.writeText(textToCopy).then(() => {
          const labelSpan = btn.querySelector('.copy-text');
          const originalText = labelSpan?.textContent || '';
          if (labelSpan) labelSpan.textContent = 'Copied!';
          btn.classList.add('copied');

          setTimeout(() => {
            if (labelSpan) labelSpan.textContent = originalText;
            btn.classList.remove('copied');
          }, 1800);
        });
      });
    });
  }

  // Initialize immediately or on DOM ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initUuidV8Tool);
  } else {
    initUuidV8Tool();
  }
</script>
