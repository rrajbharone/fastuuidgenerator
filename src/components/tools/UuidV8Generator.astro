---
import type { TranslationDictionary } from '../../i18n/schema';
import type { LanguageCode } from '../../i18n/languages';
import { generateUUIDv8 } from '../../utils/uuid';

interface Props {
  t: TranslationDictionary;
  lang: LanguageCode;
}

const { t, lang } = Astro.props;

// Initial server-side generation
const initialResult = generateUUIDv8({ mode: 'random' });
---

<!-- 1. Interactive Tool Container (Standard glass-panel tool-card) -->
<div class="glass-panel tool-card" id="uuid-v8-generator-tool">
  <!-- Top Action & Mode Bar -->
  <div class="tool-controls-bar">
    <div class="control-left">
      <span class="control-label">{t.uuidV8Generator.title}</span>
    </div>

    <div class="mode-switch-group" role="radiogroup" aria-label="UUID v8 Generation Mode">
      <button
        type="button"
        class="btn btn-secondary btn-sm mode-btn active"
        id="btn-mode-random"
        aria-pressed="true"
      >
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
          <path d="M16 8h.01"></path>
          <path d="M8 8h.01"></path>
          <path d="M8 16h.01"></path>
          <path d="M16 16h.01"></path>
          <path d="M12 12h.01"></path>
        </svg>
        <span>{t.uuidV8Generator.modeRandom}</span>
      </button>

      <button
        type="button"
        class="btn btn-secondary btn-sm mode-btn"
        id="btn-mode-custom"
        aria-pressed="false"
      >
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="16 18 22 12 16 6"></polyline>
          <polyline points="8 6 2 12 8 18"></polyline>
        </svg>
        <span>{t.uuidV8Generator.modeCustom}</span>
      </button>
    </div>
  </div>

  <!-- Custom Hex Controls (Visible when Custom mode selected) -->
  <div id="v8-custom-container" class="custom-inputs-section" style="display: none;">
    <div class="presets-row">
      <span class="preset-label">Presets:</span>
      <div class="action-buttons-group">
        <button type="button" class="btn btn-secondary btn-sm preset-btn" id="btn-preset-timestamp">
          <span>{t.uuidV8Generator.presetTimestamp}</span>
        </button>
        <button type="button" class="btn btn-secondary btn-sm preset-btn" id="btn-preset-device">
          <span>{t.uuidV8Generator.presetDeviceId}</span>
        </button>
        <button type="button" class="btn btn-secondary btn-sm preset-btn" id="btn-preset-max">
          <span>{t.uuidV8Generator.presetMaxMask}</span>
        </button>
      </div>
    </div>

    <div class="input-field-group">
      <div class="input-header-row">
        <label for="v8-custom-hex-input" class="control-label">
          {t.uuidV8Generator.customHexLabel}
        </label>
        <span id="v8-hex-counter" class="char-counter">0 / 32 hex chars</span>
      </div>
      <input
        type="text"
        id="v8-custom-hex-input"
        class="input-control input-mono"
        placeholder={t.uuidV8Generator.customHexPlaceholder}
        maxlength="32"
        spellcheck="false"
        autocomplete="off"
      />
      <p class="input-help-text">{t.uuidV8Generator.customHexHelp}</p>
      <div id="v8-hex-error" class="inline-error-msg" style="display: none;"></div>
    </div>

    <div class="padding-field-group">
      <span class="control-label">{t.uuidV8Generator.paddingLabel}</span>
      <div class="radio-options-row">
        <label class="radio-option">
          <input type="radio" name="v8-padding" value="zero" checked />
          <span>{t.uuidV8Generator.paddingZero}</span>
        </label>
        <label class="radio-option">
          <input type="radio" name="v8-padding" value="random" />
          <span>{t.uuidV8Generator.paddingRandom}</span>
        </label>
      </div>
    </div>
  </div>

  <!-- Primary Action Buttons -->
  <div class="generate-action-bar">
    <button type="button" class="btn btn-primary" id="btn-v8-generate">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/>
      </svg>
      <span>{t.uuidV8Generator.generateButton}</span>
    </button>

    <button type="button" class="btn btn-outline" id="btn-v8-clear">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
      <span>{t.uuidV8Generator.clearButton}</span>
    </button>
  </div>

  <!-- Results Section -->
  <div class="results-container" id="v8-results-area">
    <div class="results-header">
      <span class="control-label">{t.uuidV8Generator.resultsLabel}</span>
      <div class="badges-row">
        <span class="badge badge-brand">{t.uuidV8Generator.versionBadge}</span>
        <span class="badge badge-success">{t.uuidV8Generator.variantBadge}</span>
      </div>
    </div>

    <!-- 1. Canonical UUID (RFC 9562 8-4-4-4-12) -->
    <div class="output-card highlight-card">
      <div class="output-card-header">
        <span class="output-title">{t.uuidV8Generator.canonicalUuidLabel}</span>
        <button type="button" class="btn btn-secondary btn-sm copy-btn" data-target="out-v8-canonical" title="Copy Canonical UUID">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
          <span class="copy-text">{t.uuidV8Generator.copyButton}</span>
        </button>
      </div>
      <div class="output-value-box">
        <span id="out-v8-canonical" class="output-text output-mono">{initialResult.uuid}</span>
      </div>
    </div>

    <!-- 2. Additional Formats Grid -->
    <div class="formats-grid">
      <!-- Uppercase -->
      <div class="output-card">
        <div class="output-card-header">
          <span class="output-title">{t.uuidV8Generator.uppercaseUuidLabel}</span>
          <button type="button" class="btn btn-secondary btn-sm copy-btn" data-target="out-v8-uppercase" title="Copy Uppercase UUID">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
            <span class="copy-text">{t.uuidV8Generator.copyButton}</span>
          </button>
        </div>
        <div class="output-value-box">
          <span id="out-v8-uppercase" class="output-text output-mono">{initialResult.uuid.toUpperCase()}</span>
        </div>
      </div>

      <!-- Raw Hex (32 chars) -->
      <div class="output-card">
        <div class="output-card-header">
          <span class="output-title">{t.uuidV8Generator.rawHexLabel}</span>
          <button type="button" class="btn btn-secondary btn-sm copy-btn" data-target="out-v8-raw" title="Copy Raw Hex">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
            <span class="copy-text">{t.uuidV8Generator.copyButton}</span>
          </button>
        </div>
        <div class="output-value-box">
          <span id="out-v8-raw" class="output-text output-mono">{initialResult.rawHex}</span>
        </div>
      </div>

      <!-- URN format -->
      <div class="output-card full-width-card">
        <div class="output-card-header">
          <span class="output-title">{t.uuidV8Generator.urnLabel}</span>
          <button type="button" class="btn btn-secondary btn-sm copy-btn" data-target="out-v8-urn" title="Copy URN">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
            <span class="copy-text">{t.uuidV8Generator.copyButton}</span>
          </button>
        </div>
        <div class="output-value-box">
          <span id="out-v8-urn" class="output-text output-mono">{`urn:uuid:${initialResult.uuid}`}</span>
        </div>
      </div>
    </div>

    <!-- 3. RFC 9562 Section 5.8 Field Breakdown -->
    <div class="breakdown-wrapper">
      <h3 class="breakdown-title">{t.uuidV8Generator.fieldBreakdownTitle}</h3>
      <div class="breakdown-table-container">
        <table class="breakdown-table">
          <thead>
            <tr>
              <th>Field</th>
              <th>Bits</th>
              <th>Octets</th>
              <th>Value (Hex)</th>
              <th>Specification Role</th>
            </tr>
          </thead>
          <tbody>
            <tr class="breakdown-row">
              <td class="cell-field" data-label="Field"><code>custom_a</code></td>
              <td class="cell-bits" data-label="Bits">48 bits (bits 0–47)</td>
              <td class="cell-octets" data-label="Octets">0–5</td>
              <td class="cell-val" data-label="Value (Hex)"><span id="out-v8-custom-a" class="field-val">{initialResult.customA}</span></td>
              <td class="cell-desc" data-label="Role">{t.uuidV8Generator.customADesc}</td>
            </tr>
            <tr class="breakdown-row ver-row">
              <td class="cell-field" data-label="Field"><code>ver</code></td>
              <td class="cell-bits" data-label="Bits">4 bits (bits 48–51)</td>
              <td class="cell-octets" data-label="Octets">6 (bits 4–7)</td>
              <td class="cell-val" data-label="Value (Hex)"><span id="out-v8-ver" class="field-val badge-ver">{initialResult.versionNibble}</span></td>
              <td class="cell-desc" data-label="Role">{t.uuidV8Generator.verDesc}</td>
            </tr>
            <tr class="breakdown-row">
              <td class="cell-field" data-label="Field"><code>custom_b</code></td>
              <td class="cell-bits" data-label="Bits">12 bits (bits 52–63)</td>
              <td class="cell-octets" data-label="Octets">6–7</td>
              <td class="cell-val" data-label="Value (Hex)"><span id="out-v8-custom-b" class="field-val">{initialResult.customB}</span></td>
              <td class="cell-desc" data-label="Role">{t.uuidV8Generator.customBDesc}</td>
            </tr>
            <tr class="breakdown-row var-row">
              <td class="cell-field" data-label="Field"><code>var</code></td>
              <td class="cell-bits" data-label="Bits">2 bits (bits 64–65)</td>
              <td class="cell-octets" data-label="Octets">8 (bits 6–7)</td>
              <td class="cell-val" data-label="Value (Hex)"><span id="out-v8-var" class="field-val badge-var">{initialResult.variantNibble}</span></td>
              <td class="cell-desc" data-label="Role">{t.uuidV8Generator.varDesc}</td>
            </tr>
            <tr class="breakdown-row">
              <td class="cell-field" data-label="Field"><code>custom_c</code></td>
              <td class="cell-bits" data-label="Bits">62 bits (bits 66–127)</td>
              <td class="cell-octets" data-label="Octets">8–15</td>
              <td class="cell-val" data-label="Value (Hex)"><span id="out-v8-custom-c" class="field-val">{initialResult.customC}</span></td>
              <td class="cell-desc" data-label="Role">{t.uuidV8Generator.customCDesc}</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Binary view -->
      <div class="binary-box">
        <span class="binary-label">{t.uuidV8Generator.binaryLabel}:</span>
        <code id="out-v8-binary" class="binary-code">{initialResult.binary}</code>
      </div>
    </div>
  </div>
</div>

<!-- 2. Educational & Technical Article Content
     STRICT REQUIREMENT #6:
     Rendered as a clean, normal readable technical article (normal typography: <h2>, <h3>, <p>, <ul>, <code>, <pre>).
     NO cards, NO bordered boxes around paragraphs/headings.
-->
<article class="technical-article" id="article-uuid-v8">
  <header class="article-header">
    <h2 class="article-title">{t.uuidV8Generator.whatIsTitle}</h2>
  </header>

  <section class="article-body">
    <p class="article-lead">{t.uuidV8Generator.whatIsContentP1}</p>
    <p>{t.uuidV8Generator.whatIsContentP2}</p>

    <!-- How UUID v8 Works -->
    <h2>{t.uuidV8Generator.howItWorksTitle}</h2>
    <p>{t.uuidV8Generator.howItWorksContentP1}</p>
    <p>{t.uuidV8Generator.howItWorksContentP2}</p>

    <h3>{t.uuidV8Generator.structureSubheading}</h3>
    <ul class="spec-list">
      <li><strong>custom_a:</strong> {t.uuidV8Generator.structureCustomA}</li>
      <li><strong>ver:</strong> {t.uuidV8Generator.structureVer}</li>
      <li><strong>custom_b:</strong> {t.uuidV8Generator.structureCustomB}</li>
      <li><strong>var:</strong> {t.uuidV8Generator.structureVar}</li>
      <li><strong>custom_c:</strong> {t.uuidV8Generator.structureCustomC}</li>
    </ul>

    <!-- Bit Layout Table inside the article -->
    <div class="article-table-wrapper">
      <table class="article-spec-table">
        <thead>
          <tr>
            <th>Octet Range</th>
            <th>Field Identifier</th>
            <th>Bit Length</th>
            <th>RFC 9562 Invariant / Purpose</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><code>00 – 05</code></td>
            <td><code>custom_a</code></td>
            <td>48 bits</td>
            <td>Custom timestamp, shard prefix, or high-order enterprise identifier.</td>
          </tr>
          <tr>
            <td><code>06 (high 4)</code></td>
            <td><code>ver</code></td>
            <td>4 bits</td>
            <td><strong>Permanently 0b1000 (hex 8)</strong> — identifying Version 8.</td>
          </tr>
          <tr>
            <td><code>06 (low 4) + 07</code></td>
            <td><code>custom_b</code></td>
            <td>12 bits</td>
            <td>Sub-millisecond sequence counter, environment flags, or entity code.</td>
          </tr>
          <tr>
            <td><code>08 (high 2)</code></td>
            <td><code>var</code></td>
            <td>2 bits</td>
            <td><strong>Permanently 0b10</strong> — standard RFC 9562 / IETF Variant 1.</td>
          </tr>
          <tr>
            <td><code>08 (low 6) + 09–15</code></td>
            <td><code>custom_c</code></td>
            <td>62 bits</td>
            <td>Cryptographic CSPRNG entropy, monotonic incrementor, or worker node ID.</td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- What Makes UUID v8 Different -->
    <h2>{t.uuidV8Generator.whatMakesDifferentTitle}</h2>
    <p>{t.uuidV8Generator.whatMakesDifferentP1}</p>
    <p>{t.uuidV8Generator.whatMakesDifferentP2}</p>

    <!-- UUID v8 vs UUID v4 -->
    <h2>{t.uuidV8Generator.v8VsV4Title}</h2>
    <p>{t.uuidV8Generator.v8VsV4P1}</p>
    <p>{t.uuidV8Generator.v8VsV4P2}</p>

    <!-- UUID v8 vs UUID v7 -->
    <h2>{t.uuidV8Generator.v8VsV7Title}</h2>
    <p>{t.uuidV8Generator.v8VsV7P1}</p>
    <p>{t.uuidV8Generator.v8VsV7P2}</p>

    <!-- When to Use -->
    <h2>{t.uuidV8Generator.whenToUseTitle}</h2>
    <p>{t.uuidV8Generator.whenToUseP1}</p>
    <ul class="usage-list">
      <li><strong>Custom Epochs & High-Precision Timestamps:</strong> {t.uuidV8Generator.whenToUseItem1}</li>
      <li><strong>Database Partitioning & Multi-Tenant Sharding:</strong> {t.uuidV8Generator.whenToUseItem2}</li>
      <li><strong>Legacy GUID Migration & Enterprise Systems:</strong> {t.uuidV8Generator.whenToUseItem3}</li>
      <li><strong>Cryptographic Nonces with Embedded Telemetry:</strong> {t.uuidV8Generator.whenToUseItem4}</li>
    </ul>

    <!-- When to Avoid -->
    <h2>{t.uuidV8Generator.whenAvoidTitle ? t.uuidV8Generator.whenAvoidTitle : t.uuidV8Generator.whenToAvoidTitle}</h2>
    <p>{t.uuidV8Generator.whenToAvoidP1}</p>
    <ul class="avoidance-list">
      <li><strong>Public APIs & Third-Party Integrations:</strong> {t.uuidV8Generator.whenToAvoidItem1}</li>
      <li><strong>Standard Web Application Primary Keys:</strong> {t.uuidV8Generator.whenToAvoidItem2}</li>
      <li><strong>Security-Critical Opaque Identifiers:</strong> {t.uuidV8Generator.whenToAvoidItem3}</li>
      <li><strong>Interoperability Without a Shared Schema:</strong> {t.uuidV8Generator.whenToAvoidItem4}</li>
    </ul>

    <!-- Architecture Layout Examples -->
    <h2>{t.uuidV8Generator.examplesTitle}</h2>
    <p>{t.uuidV8Generator.examplesP1}</p>
    <ul class="examples-list">
      <li>{t.uuidV8Generator.examplesItem1}</li>
      <li>{t.uuidV8Generator.examplesItem2}</li>
      <li>{t.uuidV8Generator.examplesItem3}</li>
    </ul>

    <!-- 10 Technical FAQs -->
    <h2>{t.uuidV8Generator.faqTitle}</h2>
    <div class="faq-container">
      {t.uuidV8Generator.faqs.map((faq, index) => (
        <details class="faq-item" id={`faq-${index + 1}`}>
          <summary class="faq-question">
            <span>{faq.question}</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="faq-chevron">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </summary>
          <div class="faq-answer">
            <p>{faq.answer}</p>
          </div>
        </details>
      ))}
    </div>
  </section>
</article>

<style>
  /* ==========================================================================
     UUID v8 Generator Styles
     1. Tool Card: Standard glass-panel tool-card
     2. Article: Clean readable typography (NO CARDS, NO BOXES)
     ========================================================================== */

  .tool-card {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-bottom: 3.5rem;
  }

  .tool-controls-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .control-left {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .control-label {
    font-size: 0.875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-secondary);
  }

  .mode-switch-group {
    display: inline-flex;
    background: var(--bg-secondary);
    padding: 0.25rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-subtle);
    gap: 0.25rem;
  }

  .mode-btn {
    border: none;
    background: transparent;
    color: var(--text-secondary);
    padding: 0.45rem 0.9rem;
    font-size: 0.85rem;
    font-weight: 600;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .mode-btn.active {
    background: var(--bg-primary);
    color: var(--brand-primary) !important;
    box-shadow: var(--shadow-sm);
  }

  .custom-inputs-section {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 1.25rem;
    background: var(--bg-secondary);
    border-radius: var(--radius-md);
    border: 1px solid var(--border-subtle);
  }

  .presets-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .preset-label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-muted);
  }

  .action-buttons-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .input-field-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .input-header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .char-counter {
    font-size: 0.8rem;
    font-family: var(--font-mono);
    color: var(--text-muted);
  }

  .input-help-text {
    font-size: 0.825rem;
    color: var(--text-muted);
    line-height: 1.5;
    margin: 0;
  }

  .inline-error-msg {
    color: var(--accent-danger);
    font-size: 0.85rem;
    font-weight: 500;
    margin-top: 0.25rem;
  }

  .padding-field-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .radio-options-row {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .radio-option {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    color: var(--text-primary);
    cursor: pointer;
    user-select: none;
  }

  .generate-action-bar {
    display: flex;
    gap: 0.75rem;
    align-items: center;
  }

  /* Results area */
  .results-container {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding-top: 0.75rem;
  }

  .results-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .badges-row {
    display: flex;
    gap: 0.5rem;
  }

  .output-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 1rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .highlight-card {
    background: var(--bg-primary);
    border: 1.5px solid var(--brand-primary);
    box-shadow: 0 2px 10px var(--brand-glow);
  }

  .output-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .output-title {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .output-value-box {
    word-break: break-all;
    overflow-wrap: anywhere;
  }

  .output-text {
    font-size: 1.15rem;
