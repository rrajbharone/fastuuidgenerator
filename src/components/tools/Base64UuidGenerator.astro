---
import type { TranslationDictionary } from '../../i18n/schema';
import type { LanguageCode } from '../../i18n/languages';
import { generateUUIDv4, uuidToBase64 } from '../../utils/uuid';

interface Props {
  t: TranslationDictionary;
  lang: LanguageCode;
}

const { t, lang } = Astro.props;

const initialUuid = generateUUIDv4();
const initialUrlSafe = uuidToBase64(initialUuid, { urlSafe: true, padding: false });
const initialStdBase64 = uuidToBase64(initialUuid, { urlSafe: false, padding: true });
const initialHex = initialUuid.replace(/-/g, '');
---

<div class="glass-panel tool-card" id="base64-uuid-tool">
  <!-- Mode Switcher Tabs -->
  <div class="mode-tabs-nav" role="tablist" aria-label={t.base64Generator.conversionModeLabel}>
    <button
      type="button"
      class="mode-tab-btn active"
      id="tab-mode-encode"
      role="tab"
      aria-selected="true"
      aria-controls="panel-mode-encode"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 12h16"></path>
        <path d="m14 6 6 6-6 6"></path>
      </svg>
      <span>{t.base64Generator.modeUuidToBase64}</span>
    </button>

    <button
      type="button"
      class="mode-tab-btn"
      id="tab-mode-decode"
      role="tab"
      aria-selected="false"
      aria-controls="panel-mode-decode"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M20 12H4"></path>
        <path d="m10 18-6-6 6-6"></path>
      </svg>
      <span>{t.base64Generator.modeBase64ToUuid}</span>
    </button>
  </div>

  <!-- PANEL 1: UUID -> Base64 Encoder -->
  <div class="tab-panel" id="panel-mode-encode" role="tabpanel" aria-labelledby="tab-mode-encode">
    <div class="tool-controls-bar">
      <div class="control-left">
        <label for="base64-version-select" class="control-label">
          {t.base64Generator.selectVersionLabel}
        </label>
        <select id="base64-version-select" class="select-control version-select">
          <option value="v4">UUID v4 (Cryptographically Random)</option>
          <option value="v7">UUID v7 (Time-Ordered RFC 9562)</option>
        </select>
      </div>

      <div class="action-buttons-group">
        <button type="button" class="btn btn-primary" id="btn-generate-base64">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="23 4 23 10 17 10"></polyline>
            <polyline points="1 20 1 14 7 14"></polyline>
            <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
          </svg>
          <span>{t.base64Generator.generateNew}</span>
        </button>

        <button type="button" class="btn btn-secondary btn-sm" id="btn-clear-encode">
          <span>{t.common.clear}</span>
        </button>
      </div>
    </div>

    <!-- Live UUID Input -->
    <div class="input-field-group">
      <label for="uuid-source-input" class="control-label">
        {t.base64Generator.uuidInputLabel}
      </label>
      <input
        type="text"
        id="uuid-source-input"
        class="input-control input-mono"
        placeholder={t.base64Generator.uuidInputPlaceholder}
        value={initialUuid}
        spellcheck="false"
        autocomplete="off"
      />
      <div id="uuid-encode-error" class="inline-error-msg" style="display: none;">
        {t.base64Generator.invalidUuidError}
      </div>
    </div>

    <!-- Output Representations -->
    <div class="results-container" id="encode-results-box">
      <div class="results-header-row">
        <span class="badge badge-brand">{t.base64Generator.resultsLabel}</span>
        <span class="privacy-note">{t.common.privacyNotice}</span>
      </div>

      <div class="outputs-stack">
        <!-- 1. URL-Safe Base64 (Primary Recommendation) -->
        <div class="output-card highlight-card">
          <div class="output-meta">
            <div class="output-title-group">
              <span class="output-title">{t.base64Generator.urlSafeBase64Label}</span>
              <span class="badge badge-success">22 chars • Recommended for URLs</span>
            </div>
            <button type="button" class="btn btn-primary btn-sm copy-btn" data-target="out-urlsafe-b64">
              <span class="copy-label">{t.common.copy}</span>
            </button>
          </div>
          <div class="output-value-box">
            <code class="output-text input-mono" id="out-urlsafe-b64">{initialUrlSafe}</code>
          </div>
        </div>

        <!-- 2. Standard Base64 -->
        <div class="output-card">
          <div class="output-meta">
            <div class="output-title-group">
              <span class="output-title">{t.base64Generator.standardBase64Label}</span>
              <span class="badge badge-neutral">24 chars • RFC 4648</span>
            </div>
            <button type="button" class="btn btn-secondary btn-sm copy-btn" data-target="out-std-b64">
              <span class="copy-label">{t.common.copy}</span>
            </button>
          </div>
          <div class="output-value-box">
            <code class="output-text input-mono" id="out-std-b64">{initialStdBase64}</code>
          </div>
        </div>

        <!-- 3. Canonical UUID -->
        <div class="output-card">
          <div class="output-meta">
            <div class="output-title-group">
              <span class="output-title">{t.base64Generator.canonicalUuidLabel}</span>
              <span class="badge badge-neutral">36 chars</span>
            </div>
            <button type="button" class="btn btn-secondary btn-sm copy-btn" data-target="out-canonical-uuid">
              <span class="copy-label">{t.common.copy}</span>
            </button>
          </div>
          <div class="output-value-box">
            <code class="output-text input-mono" id="out-canonical-uuid">{initialUuid}</code>
          </div>
        </div>

        <!-- 4. Raw 16-Byte Hex -->
        <div class="output-card">
          <div class="output-meta">
            <div class="output-title-group">
              <span class="output-title">{t.base64Generator.rawBytesHexLabel}</span>
              <span class="badge badge-neutral">32 chars hex</span>
            </div>
            <button type="button" class="btn btn-secondary btn-sm copy-btn" data-target="out-raw-hex">
              <span class="copy-label">{t.common.copy}</span>
            </button>
          </div>
          <div class="output-value-box">
            <code class="output-text input-mono" id="out-raw-hex">{initialHex}</code>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- PANEL 2: Base64 -> UUID Decoder -->
  <div class="tab-panel" id="panel-mode-decode" role="tabpanel" aria-labelledby="tab-mode-decode" style="display: none;">
    <div class="input-field-group" style="margin-bottom: 1.25rem;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.4rem;">
        <label for="base64-source-input" class="control-label" style="margin-bottom: 0;">
          {t.base64Generator.base64InputLabel}
        </label>
        <div style="display: flex; gap: 0.5rem;">
          <button type="button" class="btn btn-secondary btn-sm" id="btn-sample-b64">
            <span>Sample Base64</span>
          </button>
          <button type="button" class="btn btn-outline btn-sm" id="btn-clear-decode">
            <span>{t.common.clear}</span>
          </button>
        </div>
      </div>
      <input
        type="text"
        id="base64-source-input"
        class="input-control input-mono"
        placeholder={t.base64Generator.base64InputPlaceholder}
        spellcheck="false"
        autocomplete="off"
      />
      <div id="b64-decode-error" class="inline-error-msg" style="display: none;">
        {t.base64Generator.invalidBase64Error}
      </div>
    </div>

    <!-- Decoded UUID Outputs -->
    <div class="results-container" id="decode-results-box" style="display: none;">
      <div class="results-header-row">
        <span class="badge badge-success">✓ Decoded Successfully</span>
        <span class="privacy-note">16 bytes / 128 bits decoded</span>
      </div>

      <div class="outputs-stack">
        <!-- Canonical UUID -->
        <div class="output-card highlight-card">
          <div class="output-meta">
            <div class="output-title-group">
              <span class="output-title">{t.base64Generator.canonicalUuidLabel}</span>
              <span class="badge badge-brand">Standard (8-4-4-4-12)</span>
            </div>
            <button type="button" class="btn btn-primary btn-sm copy-btn" data-target="dec-canonical-uuid">
              <span class="copy-label">{t.common.copy}</span>
            </button>
          </div>
          <div class="output-value-box">
            <code class="output-text input-mono" id="dec-canonical-uuid"></code>
          </div>
        </div>

        <!-- Uppercase UUID -->
        <div class="output-card">
          <div class="output-meta">
            <span class="output-title">{t.generator.formatting.uppercase}</span>
            <button type="button" class="btn btn-secondary btn-sm copy-btn" data-target="dec-uppercase-uuid">
              <span class="copy-label">{t.common.copy}</span>
            </button>
          </div>
          <div class="output-value-box">
            <code class="output-text input-mono" id="dec-uppercase-uuid"></code>
          </div>
        </div>

        <!-- No Hyphens Hex -->
        <div class="output-card">
          <div class="output-meta">
            <span class="output-title">{t.generator.formatting.noHyphens}</span>
            <button type="button" class="btn btn-secondary btn-sm copy-btn" data-target="dec-nohyphens-uuid">
              <span class="copy-label">{t.common.copy}</span>
            </button>
          </div>
          <div class="output-value-box">
            <code class="output-text input-mono" id="dec-nohyphens-uuid"></code>
          </div>
        </div>

        <!-- C# Guid -->
        <div class="output-card">
          <div class="output-meta">
            <span class="output-title">{t.generator.formatting.csharpGuid}</span>
            <button type="button" class="btn btn-secondary btn-sm copy-btn" data-target="dec-csharp-guid">
              <span class="copy-label">{t.common.copy}</span>
            </button>
          </div>
          <div class="output-value-box">
            <code class="output-text input-mono" id="dec-csharp-guid"></code>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Educational SEO Content Section: Exactly 9 Cards -->
<div class="educational-section-wrapper">
  <div class="educational-header">
    <span class="badge badge-brand">{t.educational.technicalReferenceBadge}</span>
    <h2 class="educational-title">{t.base64Generator.whatIsTitle}</h2>
    <p class="educational-subtitle">{t.base64Generator.subtitle}</p>
  </div>

  <!-- 9 High-Value Base64 UUID Information Cards in Single Grid -->
  <div class="educational-grid">
    <!-- Card 1: What is Base64 UUID -->
    <div class="glass-panel edu-card" id="card-what-is-base64-uuid">
      <div class="edu-icon-wrapper">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
          <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
        </svg>
      </div>
      <h3 class="edu-card-title">{t.base64Generator.whatIsTitle}</h3>
      <p class="edu-card-text">{t.base64Generator.whatIsContent}</p>
    </div>

    <!-- Card 2: How It Works -->
    <div class="glass-panel edu-card" id="card-how-it-works">
      <div class="edu-icon-wrapper">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="16 18 22 12 16 6"></polyline>
          <polyline points="8 6 2 12 8 18"></polyline>
        </svg>
      </div>
      <h3 class="edu-card-title">{t.base64Generator.howItWorksTitle}</h3>
      <p class="edu-card-text">{t.base64Generator.howItWorksContent}</p>
    </div>

    <!-- Card 3: Standard vs URL-Safe -->
    <div class="glass-panel edu-card" id="card-standard-vs-urlsafe">
      <div class="edu-icon-wrapper">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="2" y1="12" x2="22" y2="12"></line>
          <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
        </svg>
      </div>
      <h3 class="edu-card-title">{t.base64Generator.standardVsUrlSafeTitle}</h3>
      <p class="edu-card-text">{t.base64Generator.standardVsUrlSafeContent}</p>
    </div>

    <!-- Card 4: Key Use Cases -->
    <div class="glass-panel edu-card" id="card-key-use-cases">
      <div class="edu-icon-wrapper">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
        </svg>
      </div>
      <h3 class="edu-card-title">{t.base64Generator.useCasesTitle}</h3>
      <p class="edu-card-text">{t.base64Generator.useCasesContent}</p>
    </div>

    <!-- Card 5: How to Convert UUID to Base64 -->
    <div class="glass-panel edu-card" id="card-convert-uuid-to-base64">
      <div class="edu-icon-wrapper">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <polyline points="12 16 16 12 12 8"></polyline>
          <line x1="8" y1="12" x2="16" y2="12"></line>
        </svg>
      </div>
      <h3 class="edu-card-title">{t.base64Generator.convertUuidTitle}</h3>
      <p class="edu-card-text">{t.base64Generator.convertUuidContent}</p>
    </div>

    <!-- Card 6: How to Convert Base64 Back to UUID -->
    <div class="glass-panel edu-card" id="card-convert-base64-to-uuid">
      <div class="edu-icon-wrapper">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="1 4 1 10 7 10"></polyline>
          <polyline points="23 20 23 14 17 14"></polyline>
          <path d="M20.49 9A9 9 0 0 0 5.64 5.64L1 10m22 4l-4.64 4.36A9 9 0 0 1 3.51 15"></path>
        </svg>
      </div>
      <h3 class="edu-card-title">{t.base64Generator.convertBase64Title}</h3>
      <p class="edu-card-text">{t.base64Generator.convertBase64Content}</p>
    </div>

    <!-- Card 7: Why Use Base64 UUIDs -->
    <div class="glass-panel edu-card" id="card-why-use-base64">
      <div class="edu-icon-wrapper">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
        </svg>
      </div>
      <h3 class="edu-card-title">{t.base64Generator.whyUseTitle}</h3>
      <p class="edu-card-text">{t.base64Generator.whyUseContent}</p>
    </div>

    <!-- Card 8: Where Are Base64 UUIDs Used -->
    <div class="glass-panel edu-card" id="card-where-base64-used">
      <div class="edu-icon-wrapper">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="2" width="20" height="8" rx="2" ry="2"></rect>
          <rect x="2" y="14" width="20" height="8" rx="2" ry="2"></rect>
          <line x1="6" y1="6" x2="6.01" y2="6"></line>
          <line x1="6" y1="18" x2="6.01" y2="18"></line>
        </svg>
      </div>
      <h3 class="edu-card-title">{t.base64Generator.whereUsedTitle}</h3>
      <p class="edu-card-text">{t.base64Generator.whereUsedContent}</p>
    </div>

    <!-- Card 9: Base64 UUID vs Standard UUID -->
    <div class="glass-panel edu-card" id="card-base64-vs-standard">
      <div class="edu-icon-wrapper">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="4" y1="21" x2="4" y2="14"></line>
          <line x1="4" y1="10" x2="4" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="12"></line>
          <line x1="12" y1="8" x2="12" y2="3"></line>
          <line x1="20" y1="21" x2="20" y2="16"></line>
          <line x1="20" y1="12" x2="20" y2="3"></line>
          <line x1="1" y1="14" x2="7" y2="14"></line>
          <line x1="9" y1="8" x2="15" y2="8"></line>
          <line x1="17" y1="16" x2="23" y2="16"></line>
        </svg>
      </div>
      <h3 class="edu-card-title">{t.base64Generator.comparisonTitle}</h3>
      <p class="edu-card-text">{t.base64Generator.comparisonContent}</p>
    </div>
  </div>

  <!-- FAQ Accordion Section -->
  <section class="faq-section-wrapper" aria-labelledby="base64-faq-heading">
    <div class="faq-header">
      <h2 id="base64-faq-heading" class="faq-heading">{t.base64Generator.faqTitle}</h2>
      <p class="faq-subheading">Instant answers to technical questions regarding Base64 UUID encoding, decoding, and URL safety.</p>
    </div>

    <div class="faq-accordion-list">
      {t.base64Generator.faqs.map((faq, index) => (
        <details class="faq-item" id={`base64-faq-${index + 1}`}>
          <summary class="faq-question">
            <span>{faq.question}</span>
            <svg class="faq-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </summary>
          <div class="faq-answer">
            <p>{faq.answer}</p>
          </div>
        </details>
      ))}
    </div>
  </section>
</div>

<style>
  .mode-tabs-nav {
    display: flex;
    gap: 0.5rem;
    padding-bottom: 1rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--border-subtle);
    overflow-x: auto;
  }

  .mode-tab-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1.15rem;
    font-size: 0.95rem;
    font-weight: 600;
    font-family: var(--font-sans);
    border-radius: var(--radius-md);
    background: var(--bg-secondary);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    cursor: pointer;
    transition: all 0.15s ease;
    white-space: nowrap;
  }

  .mode-tab-btn:hover {
    background: #e2e8f0;
    color: var(--text-primary);
    border-color: var(--border-subtle);
  }

  [data-theme="dark"] .mode-tab-btn:hover {
    background: #334155;
  }

  .mode-tab-btn.active {
    background: var(--brand-primary);
    color: #ffffff !important;
    border-color: var(--brand-primary);
    box-shadow: 0 2px 8px var(--brand-glow);
  }

  .tool-controls-bar {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1rem;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
  }

  .control-left {
    flex: 1;
    min-width: 220px;
  }

  .control-label {
    display: block;
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 0.4rem;
    color: var(--text-primary);
    font-family: var(--font-sans);
  }

  .version-select {
    max-width: 360px;
  }

  .action-buttons-group {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  .input-field-group {
    margin-bottom: 1.5rem;
  }

  .inline-error-msg {
    color: var(--accent-danger, #ef4444);
    font-size: 0.825rem;
    margin-top: 0.4rem;
    font-weight: 500;
  }

  .results-container {
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border-glass);
  }

  .results-header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .privacy-note {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .outputs-stack {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .output-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border-glass);
    border-radius: var(--radius-md);
    padding: 0.85rem 1rem;
    transition: border-color 0.15s ease;
  }

  .output-card.highlight-card {
    background: var(--bg-elevated);
    border-color: var(--brand-primary);
    box-shadow: 0 2px 10px var(--brand-glow);
  }

  .output-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.4rem;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .output-title-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .output-title {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-primary);
    font-family: var(--font-sans);
  }

  .output-value-box {
    background: var(--bg-glass-subtle);
    padding: 0.6rem 0.75rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-subtle);
    overflow-x: auto;
  }

  .output-text {
    font-size: 0.95rem;
    color: var(--text-primary);
    word-break: break-all;
    user-select: all;
  }

  /* Educational Section: 9 Cards Grid Styling */
  .educational-section-wrapper {
    margin-top: 3.5rem;
  }

  .educational-header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 2.5rem;
  }

  .educational-title {
    font-size: 1.85rem;
    font-weight: 700;
    margin: 0.6rem 0 0.5rem;
    color: var(--text-primary);
    letter-spacing: -0.02em;
  }

  .educational-subtitle {
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .educational-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
    margin-bottom: 3.5rem;
  }

  .edu-card {
    padding: 1.65rem;
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-lg);
    background: var(--bg-glass);
    border: 1px solid var(--border-glass);
    transition: transform 0.15s ease, border-color 0.15s ease;
  }

  .edu-card:hover {
    border-color: var(--border-focus);
    transform: translateY(-2px);
  }

  .edu-icon-wrapper {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    background: var(--brand-glow);
    color: var(--brand-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
    border: 1px solid var(--border-glass);
    flex-shrink: 0;
  }

  .edu-card-title {
    font-size: 1.15rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
    color: var(--text-primary);
    line-height: 1.4;
  }

  .edu-card-text {
    font-size: 0.925rem;
    color: var(--text-secondary);
    line-height: 1.65;
    margin: 0;
  }

  /* FAQ Accordion Styling */
  .faq-section-wrapper {
    margin: 3.5rem 0;
    padding-top: 1rem;
    font-family: var(--font-sans);
  }

  .faq-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 2rem;
  }

  .faq-heading {
    font-size: 1.75rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    color: var(--text-primary);
    font-family: var(--font-sans);
  }

  .faq-subheading {
    font-size: 1rem;
    color: var(--text-secondary);
    font-family: var(--font-sans);
  }

  .faq-accordion-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: 820px;
    margin: 0 auto;
  }

  .faq-item {
    background: var(--bg-glass);
    border: 1px solid var(--border-glass);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: border-color 0.15s ease;
    font-family: var(--font-sans);
  }

  .faq-item[open] {
    border-color: var(--border-focus);
    background: var(--bg-elevated);
  }

  .faq-question {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.1rem 1.25rem;
    font-weight: 600;
    font-size: 1rem;
    color: var(--text-primary);
    cursor: pointer;
    user-select: none;
    list-style: none;
    font-family: var(--font-sans);
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-chevron {
    transition: transform 0.2s ease;
    flex-shrink: 0;
    color: var(--text-muted);
  }

  .faq-item[open] .faq-chevron {
    transform: rotate(180deg);
    color: var(--brand-primary);
  }

  .faq-answer {
    padding: 0 1.25rem 1.25rem;
    font-size: 0.925rem;
    color: var(--text-secondary);
    line-height: 1.7;
    font-family: var(--font-sans);
  }

  @media (max-width: 640px) {
    .tool-controls-bar {
      flex-direction: column;
      align-items: stretch;
    }
    .control-left, .version-select {
      max-width: 100%;
      width: 100%;
    }
    .action-buttons-group {
      width: 100%;
    }
    .action-buttons-group .btn {
      flex: 1;
    }
    .edu-card {
      padding: 1.25rem;
    }
  }
</style>

<script>
  import { generateUUIDv4, generateUUIDv7, uuidToBase64, base64ToUuid, formatUUID } from '../../utils/uuid';

  function initBase64Tool() {
    // Mode tabs
    const tabEncode = document.getElementById('tab-mode-encode');
    const tabDecode = document.getElementById('tab-mode-decode');
    const panelEncode = document.getElementById('panel-mode-encode');
    const panelDecode = document.getElementById('panel-mode-decode');

    // Encode controls
    const versionSelect = document.getElementById('base64-version-select') as HTMLSelectElement;
    const btnGenerate = document.getElementById('btn-generate-base64');
    const btnClearEncode = document.getElementById('btn-clear-encode');
    const uuidInput = document.getElementById('uuid-source-input') as HTMLInputElement;
    const encodeError = document.getElementById('uuid-encode-error');

    // Encode outputs
    const outUrlSafe = document.getElementById('out-urlsafe-b64');
    const outStd = document.getElementById('out-std-b64');
    const outCanonical = document.getElementById('out-canonical-uuid');
    const outHex = document.getElementById('out-raw-hex');

    // Decode controls & outputs
    const b64Input = document.getElementById('base64-source-input') as HTMLInputElement;
    const btnSampleB64 = document.getElementById('btn-sample-b64');
    const btnClearDecode = document.getElementById('btn-clear-decode');
    const decodeError = document.getElementById('b64-decode-error');
    const decodeResultsBox = document.getElementById('decode-results-box');

    const decCanonical = document.getElementById('dec-canonical-uuid');
    const decUppercase = document.getElementById('dec-uppercase-uuid');
    const decNoHyphens = document.getElementById('dec-nohyphens-uuid');
    const decCsharp = document.getElementById('dec-csharp-guid');

    if (!tabEncode || !tabDecode) return;

    // Tab Switching
    tabEncode.addEventListener('click', () => {
      tabEncode.classList.add('active');
      tabEncode.setAttribute('aria-selected', 'true');
      tabDecode.classList.remove('active');
      tabDecode.setAttribute('aria-selected', 'false');

      if (panelEncode) panelEncode.style.display = 'block';
      if (panelDecode) panelDecode.style.display = 'none';
    });

    tabDecode.addEventListener('click', () => {
      tabDecode.classList.add('active');
      tabDecode.setAttribute('aria-selected', 'true');
      tabEncode.classList.remove('active');
      tabEncode.setAttribute('aria-selected', 'false');

      if (panelDecode) panelDecode.style.display = 'block';
      if (panelEncode) panelEncode.style.display = 'none';
    });

    // Copy Handler Helper
    document.querySelectorAll('.copy-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-target');
        if (!targetId) return;
        const targetEl = document.getElementById(targetId);
        if (!targetEl) return;
        const text = targetEl.textContent || '';
        if (!text) return;

        navigator.clipboard.writeText(text).then(() => {
          const label = btn.querySelector('.copy-label');
          if (label) {
            const prev = label.textContent;
            label.textContent = 'Copied!';
            setTimeout(() => { label.textContent = prev; }, 1500);
          }
        });
      });
    });

    // ENCODE: Process UUID -> Base64
    function processUuidToB64(uuid: string) {
      const cleanHex = uuid.replace(/[^0-9a-fA-F]/g, '');
      if (cleanHex.length !== 32) {
        if (encodeError) encodeError.style.display = 'block';
        if (outUrlSafe) outUrlSafe.textContent = '';
        if (outStd) outStd.textContent = '';
        if (outCanonical) outCanonical.textContent = '';
        if (outHex) outHex.textContent = '';
        return;
      }

      if (encodeError) encodeError.style.display = 'none';

      const formattedCanonical = formatUUID(cleanHex);
      const stdB64 = uuidToBase64(formattedCanonical, { urlSafe: false, padding: true });
      const urlSafeB64 = uuidToBase64(formattedCanonical, { urlSafe: true, padding: false });

      if (outUrlSafe) outUrlSafe.textContent = urlSafeB64;
      if (outStd) outStd.textContent = stdB64;
      if (outCanonical) outCanonical.textContent = formattedCanonical;
      if (outHex) outHex.textContent = cleanHex.toLowerCase();
    }

    // Generate New UUID
    function generateNew() {
      const version = versionSelect ? versionSelect.value : 'v4';
      const newUuid = version === 'v7' ? generateUUIDv7() : generateUUIDv4();
      if (uuidInput) uuidInput.value = newUuid;
      processUuidToB64(newUuid);
    }

    const encodeResultsBox = document.getElementById('encode-results-box') as HTMLElement;

    function scrollToResultsOnMobile() {
      if (window.matchMedia('(max-width: 768px)').matches && encodeResultsBox) {
        const headerOffset = 76;
        const elementPosition = encodeResultsBox.getBoundingClientRect().top;
        const offsetPosition = elementPosition + window.pageYOffset - headerOffset;
        window.scrollTo({
          top: Math.max(0, offsetPosition),
          behavior: 'smooth',
        });
      }
    }

    if (btnGenerate) {
      btnGenerate.addEventListener('click', () => {
        generateNew();
        scrollToResultsOnMobile();
      });
    }
    if (versionSelect) versionSelect.addEventListener('change', generateNew);

    if (uuidInput) {
      uuidInput.addEventListener('input', () => {
        processUuidToB64(uuidInput.value);
      });
    }

    if (btnClearEncode) {
      btnClearEncode.addEventListener('click', () => {
        if (uuidInput) uuidInput.value = '';
        processUuidToB64('');
      });
    }

    // DECODE: Process Base64 -> UUID
    function processB64ToUuid(b64: string) {
      const trimmed = b64.trim();
      if (!trimmed) {
        if (decodeError) decodeError.style.display = 'none';
        if (decodeResultsBox) decodeResultsBox.style.display = 'none';
        return;
      }

      const res = base64ToUuid(trimmed);
      if (!res.isValid) {
        if (decodeError) {
          decodeError.textContent = res.error || 'Invalid Base64 string';
          decodeError.style.display = 'block';
        }
        if (decodeResultsBox) decodeResultsBox.style.display = 'none';
        return;
      }

      if (decodeError) decodeError.style.display = 'none';
      if (decodeResultsBox) decodeResultsBox.style.display = 'block';

      if (decCanonical) decCanonical.textContent = res.canonicalUuid;
      if (decUppercase) decUppercase.textContent = formatUUID(res.canonicalUuid, { casing: 'uppercase' });
      if (decNoHyphens) decNoHyphens.textContent = res.rawHex;
      if (decCsharp) decCsharp.textContent = formatUUID(res.canonicalUuid, { csharp: true });
    }

    if (b64Input) {
      b64Input.addEventListener('input', () => {
        processB64ToUuid(b64Input.value);
      });
    }

    if (btnSampleB64) {
      btnSampleB64.addEventListener('click', () => {
        const sampleB64 = 'VQ6EAOKbQdSnFkRmVUQAAA';
        if (b64Input) {
          b64Input.value = sampleB64;
          processB64ToUuid(sampleB64);
        }
      });
    }

    if (btnClearDecode) {
      btnClearDecode.addEventListener('click', () => {
        if (b64Input) b64Input.value = '';
        processB64ToUuid('');
      });
    }

    // Initial run only if not already pre-rendered
    if (!uuidInput || !uuidInput.value) {
      generateNew();
    }
  }

  initBase64Tool();
  document.addEventListener('astro:page-load', initBase64Tool);
</script>
