---
import type { TranslationDictionary } from '../../i18n/schema';

interface Props {
  t: TranslationDictionary;
}

const { t } = Astro.props;
---

<div class="container">
  <article class="technical-article" id="article-uuid-guide">
    <header class="article-header">
      <h2 class="article-title">{t.educational.everythingYouNeedTitle}</h2>
      {t.educational.everythingYouNeedSubtitle && <p class="article-lead">{t.educational.everythingYouNeedSubtitle}</p>}
    </header>

    <section class="article-body">
      <h2>{t.educational.whatIsUuidTitle}</h2>
      <p>{t.educational.whatIsUuidContent}</p>

      <h2>{t.educational.uuidVersionsTitle}</h2>
      <p>{t.educational.uuidVersionsContent}</p>

      <h2>{t.educational.uuidVsGuidTitle}</h2>
      <p>{t.educational.uuidVsGuidContent}</p>

      <h2>{t.educational.useCasesTitle}</h2>
      <p>{t.educational.useCasesContent}</p>

      <h2>{t.educational.securityTitle}</h2>
      <p>{t.educational.securityContent}</p>

      <h2>{t.educational.toolSuiteTitle}</h2>
      <p>{t.educational.toolSuiteContent}</p>

      <h2>{t.educational.faqTitle}</h2>
      <div class="faq-container">
        {t.educational.faqs.map((faq, index) => (
          <details class="faq-item" id={`faq-${index + 1}`}>
            <summary class="faq-question">
              <span>{faq.question}</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="faq-chevron">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </summary>
            <div class="faq-answer">
              <p>{faq.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </section>
  </article>
</div>
