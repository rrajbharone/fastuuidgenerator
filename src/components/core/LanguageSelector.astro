---
import { SUPPORTED_LANGUAGES, LANGUAGE_CODES, type LanguageCode } from '../../i18n/languages';
import { getLocalizedPath } from '../../i18n/utils';
import type { TranslationDictionary } from '../../i18n/schema';

interface Props {
  currentLang: LanguageCode;
  currentPath: string;
  t: TranslationDictionary;
}

const { currentLang, currentPath, t } = Astro.props;
const currentLangMeta = SUPPORTED_LANGUAGES[currentLang];
---

<div class="dropdown" id="lang-dropdown">
  <button
    type="button"
    class="btn btn-secondary btn-sm lang-btn"
    id="lang-dropdown-btn"
    aria-expanded="false"
    aria-haspopup="true"
    aria-label={t.language.selectLanguage}
    title={t.language.selectLanguage}
  >
    <!-- Globe Icon -->
    <svg class="globe-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="10"></circle>
      <line x1="2" y1="12" x2="22" y2="12"></line>
      <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
    </svg>
    <span class="lang-flag" aria-hidden="true">{currentLangMeta.flag}</span>
    <span class="lang-text">{currentLangMeta.nativeName}</span>
    <svg class="chevron-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="6 9 12 15 18 9"></polyline>
    </svg>
  </button>

  <ul class="dropdown-menu" id="lang-dropdown-menu" role="menu" aria-label={t.language.selectLanguage}>
    {LANGUAGE_CODES.map((code) => {
      const meta = SUPPORTED_LANGUAGES[code];
      const targetUrl = getLocalizedPath(currentPath, code);
      const isCurrent = code === currentLang;
      return (
        <li role="none">
          <a
            href={targetUrl}
            class={`dropdown-item ${isCurrent ? 'active' : ''}`}
            role="menuitem"
            hreflang={code}
          >
            <span style="display: flex; align-items: center; gap: 0.5rem;">
              <span aria-hidden="true">{meta.flag}</span>
              <span>{meta.nativeName}</span>
            </span>
            {isCurrent && <span class="badge badge-brand">✓</span>}
          </a>
        </li>
      );
    })}
  </ul>
</div>

<style>
  .lang-btn {
    gap: 0.4rem;
    padding: 0.4rem 0.65rem;
  }

  .lang-text {
    font-size: 0.85rem;
  }

  .dropdown-menu {
    position: absolute;
    top: calc(100% + 6px);
    right: 0;
    min-width: 190px;
    max-width: calc(100vw - 2rem);
    background: var(--bg-elevated);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid var(--border-glass);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lg);
    padding: 0.4rem;
    z-index: 100;
    display: none;
    list-style: none;
  }

  @media (max-width: 768px) {
    .lang-text {
      display: none;
    }
    .chevron-icon {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .lang-flag {
      display: none;
    }
  }
</style>

<script>
  function setupLangDropdown() {
    const dropdown = document.getElementById('lang-dropdown');
    const btn = document.getElementById('lang-dropdown-btn');
    if (!dropdown || !btn) return;

    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = dropdown.classList.toggle('open');
      btn.setAttribute('aria-expanded', String(isOpen));
    });

    document.addEventListener('click', (e) => {
      if (!dropdown.contains(e.target as Node)) {
        dropdown.classList.remove('open');
        btn.setAttribute('aria-expanded', 'false');
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && dropdown.classList.contains('open')) {
        dropdown.classList.remove('open');
        btn.setAttribute('aria-expanded', 'false');
        btn.focus();
      }
    });
  }

  setupLangDropdown();
  document.addEventListener('astro:page-load', setupLangDropdown);
</script>
