---
import BaseLayout from './BaseLayout.astro';
import { getTranslations } from '../i18n/utils';

interface Props {
  title: string;
  description: string;
  publishDate: Date;
  author: string;
  category: string;
  readingTime: string;
  canonicalPath: string;
}

const {
  title,
  description,
  publishDate,
  author,
  category,
  readingTime,
  canonicalPath,
} = Astro.props;

const t = getTranslations('en');
const formattedDate = publishDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout
  title={`${title} | FastUUIDGenerator Blog`}
  description={description}
  lang="en"
  canonicalPath={canonicalPath}
  isMultilingualTool={false}
  ogType="article"
  showLangSelector={false}
  breadcrumbs={[
    { name: 'Home', url: 'https://fastuuidgenerator.com/' },
    { name: 'Blog', url: 'https://fastuuidgenerator.com/blog/' },
    { name: title, url: `https://fastuuidgenerator.com${canonicalPath}` },
  ]}
>
  <div class="container" style="max-width: 820px; padding: 2.5rem 1.25rem 4rem;">
    <!-- Article Header -->
    <header style="margin-bottom: 2.5rem; text-align: center;">
      <div style="display: flex; justify-content: center; gap: 0.5rem; margin-bottom: 1rem;">
        <span class="badge badge-brand">{category}</span>
        <span class="badge badge-neutral">{readingTime}</span>
      </div>
      <h1 style="font-size: 2.4rem; line-height: 1.2; margin-bottom: 1rem; letter-spacing: -0.03em;">
        {title}
      </h1>
      <div style="display: flex; justify-content: center; align-items: center; gap: 1rem; color: var(--text-muted); font-size: 0.9rem;">
        <span>By {author}</span>
        <span>•</span>
        <time datetime={publishDate.toISOString()}>{formattedDate}</time>
      </div>
    </header>

    <!-- Article Content Card -->
    <article class="glass-panel" style="padding: 2.5rem; margin-bottom: 3rem; line-height: 1.8; font-size: 1.05rem;">
      <div class="prose-content">
        <slot />
      </div>
    </article>

    <!-- Quick Tool CTA Banner -->
    <div class="glass-panel-subtle" style="padding: 2rem; text-align: center; border-radius: var(--radius-lg);">
      <h3 style="margin-bottom: 0.5rem;">Need to generate UUIDs right now?</h3>
      <p style="margin-bottom: 1.25rem; font-size: 0.95rem;">
        Generate cryptographically secure UUID v4 or time-ordered UUID v7 identifiers instantly in your browser.
      </p>
      <div style="display: flex; justify-content: center; gap: 0.75rem; flex-wrap: wrap;">
        <a href="/uuid-generator/" class="btn btn-primary">Generate UUIDs Online</a>
        <a href="/uuid-validator/" class="btn btn-secondary">Validate a UUID</a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .prose-content :global(h2) {
    font-size: 1.55rem;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--border-glass);
  }
  .prose-content :global(h3) {
    font-size: 1.25rem;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }
  .prose-content :global(p) {
    margin-bottom: 1.25rem;
  }
  .prose-content :global(ul), .prose-content :global(ol) {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
  }
  .prose-content :global(li) {
    margin-bottom: 0.5rem;
    color: var(--text-secondary);
  }
  .prose-content :global(pre) {
    background: #0f172a !important;
    border: 1px solid rgba(255, 255, 255, 0.14) !important;
    border-radius: var(--radius-md);
    padding: 1.25rem;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    line-height: 1.6;
    margin-bottom: 1.5rem;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
  }
  .prose-content :global(pre code),
  .prose-content :global(pre span),
  .prose-content :global(pre .line) {
    background: transparent !important;
    padding: 0;
    color: #f8fafc !important;
    font-family: var(--font-mono);
  }
  .prose-content :global(code) {
    font-family: var(--font-mono);
    background: var(--bg-glass-subtle);
    padding: 0.2rem 0.45rem;
    border-radius: var(--radius-sm);
    font-size: 0.9em;
    color: var(--brand-primary);
    border: 1px solid var(--border-subtle);
  }
  .prose-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.95rem;
  }
  .prose-content :global(th), .prose-content :global(td) {
    border: 1px solid var(--border-glass);
    padding: 0.75rem 1rem;
    text-align: left;
  }
  .prose-content :global(th) {
    background: var(--bg-glass-subtle);
    font-weight: 600;
  }
</style>
