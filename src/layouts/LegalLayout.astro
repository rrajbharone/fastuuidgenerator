---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  lastUpdated?: string;
}

const {
  title,
  description,
  canonicalPath,
  lastUpdated = 'February 2026',
} = Astro.props;
---

<BaseLayout
  title={`${title} | FastUUIDGenerator`}
  description={description}
  lang="en"
  canonicalPath={canonicalPath}
  isMultilingualTool={false}
  showLangSelector={false}
  breadcrumbs={[
    { name: 'Home', url: 'https://fastuuidgenerator.com/' },
    { name: title, url: `https://fastuuidgenerator.com${canonicalPath}` },
  ]}
>
  <div class="container legal-container">
    <header class="legal-header">
      <h1 class="legal-title">{title}</h1>
      <p class="legal-date">Last Updated: {lastUpdated}</p>
    </header>

    <article class="glass-panel legal-article-card">
      <div class="legal-prose">
        <slot />
      </div>
    </article>
  </div>
</BaseLayout>

<style>
  .legal-container {
    max-width: 840px;
    padding: 3rem 1.25rem 5rem;
    margin: 0 auto;
    width: 100%;
    box-sizing: border-box;
  }

  .legal-header {
    margin-bottom: 2.5rem;
    text-align: center;
  }

  .legal-title {
    font-size: 2.25rem;
    line-height: 1.25;
    margin-bottom: 0.5rem;
    letter-spacing: -0.03em;
    overflow-wrap: break-word;
    word-break: break-word;
  }

  .legal-date {
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .legal-article-card {
    padding: 2.5rem;
    line-height: 1.8;
    box-sizing: border-box;
    width: 100%;
    overflow: hidden;
  }

  .legal-prose {
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    overflow-wrap: break-word;
    word-break: break-word;
  }

  .legal-prose :global(h2) {
    font-size: 1.4rem;
    margin-top: 1.75rem;
    margin-bottom: 0.6rem;
    color: var(--text-primary);
    line-height: 1.35;
    overflow-wrap: break-word;
    word-break: break-word;
  }

  .legal-prose :global(h3) {
    font-size: 1.2rem;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    color: var(--text-primary);
    overflow-wrap: break-word;
    word-break: break-word;
  }

  .legal-prose :global(p) {
    margin-bottom: 1.25rem;
    color: var(--text-secondary);
    line-height: 1.75;
    overflow-wrap: break-word;
    word-break: break-word;
  }

  .legal-prose :global(strong) {
    font-weight: 600;
    color: var(--text-primary);
  }

  .legal-prose :global(a) {
    color: var(--brand-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
    overflow-wrap: break-word;
    word-break: break-word;
  }

  .legal-prose :global(a:hover) {
    color: var(--brand-primary-hover);
  }

  .legal-prose :global(ul),
  .legal-prose :global(ol) {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
    box-sizing: border-box;
  }

  .legal-prose :global(li) {
    margin-bottom: 0.5rem;
    line-height: 1.7;
    color: var(--text-secondary);
    overflow-wrap: break-word;
    word-break: break-word;
  }

  .legal-prose :global(li > ul),
  .legal-prose :global(li > ol) {
    margin-top: 0.4rem;
    margin-bottom: 0.4rem;
    padding-left: 1.25rem;
  }

  .legal-prose :global(code) {
    font-family: var(--font-mono);
    background: var(--bg-secondary);
    padding: 0.2rem 0.45rem;
    border-radius: var(--radius-sm);
    font-size: 0.88em;
    color: var(--brand-primary);
    border: 1px solid var(--border-subtle);
    overflow-wrap: break-word;
    word-break: break-word;
    max-width: 100%;
  }

  .legal-prose :global(form) {
    max-width: 100%;
    box-sizing: border-box;
  }

  .legal-prose :global(input),
  .legal-prose :global(textarea) {
    width: 100%;
    box-sizing: border-box;
  }

  /* Responsive Breakpoints */
  @media (max-width: 768px) {
    .legal-container {
      padding: 2rem 1rem 3.5rem;
    }
    .legal-header {
      margin-bottom: 1.75rem;
    }
    .legal-title {
      font-size: 1.85rem;
    }
    .legal-article-card {
      padding: 1.5rem 1.25rem;
      border-radius: var(--radius-md);
    }
    .legal-prose :global(h2) {
      font-size: 1.3rem;
      margin-top: 1.5rem;
    }
    .legal-prose :global(ul),
    .legal-prose :global(ol) {
      padding-left: 1.25rem;
    }
  }

  @media (max-width: 480px) {
    .legal-container {
      padding: 1.25rem 0.65rem 2.5rem;
    }
    .legal-header {
      margin-bottom: 1.25rem;
    }
    .legal-title {
      font-size: 1.5rem;
      letter-spacing: -0.02em;
    }
    .legal-article-card {
      padding: 1.15rem 0.875rem;
      border-radius: var(--radius-md);
      font-size: 0.95rem;
      line-height: 1.7;
    }
    .legal-prose :global(h2) {
      font-size: 1.2rem;
      margin-top: 1.35rem;
    }
    .legal-prose :global(p) {
      margin-bottom: 1rem;
    }
    .legal-prose :global(ul),
    .legal-prose :global(ol) {
      padding-left: 1.15rem;
      margin-bottom: 1rem;
    }
    .legal-prose :global(li) {
      margin-bottom: 0.4rem;
    }
  }

  @media (max-width: 360px) {
    .legal-container {
      padding: 1rem 0.4rem 2rem;
    }
    .legal-title {
      font-size: 1.35rem;
    }
    .legal-article-card {
      padding: 1rem 0.65rem;
      border-radius: var(--radius-sm);
      font-size: 0.925rem;
    }
    .legal-prose :global(h2) {
      font-size: 1.15rem;
    }
    .legal-prose :global(ul),
    .legal-prose :global(ol) {
      padding-left: 1rem;
    }
  }
</style>
