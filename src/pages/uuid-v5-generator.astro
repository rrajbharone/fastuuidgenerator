---
import { getTranslations } from '../i18n/utils';
import ToolLayout from '../layouts/ToolLayout.astro';
import UuidV5Generator from '../components/tools/UuidV5Generator.astro';

const lang = 'en';
const t = getTranslations(lang);
const canonicalPath = '/uuid-v5-generator/';
---

<ToolLayout
  title={t.seo.uuidV5Title}
  description={t.seo.uuidV5Description}
  heroTitle={t.uuidV5Generator.title}
  heroSubtitle={t.uuidV5Generator.subtitle}
  lang={lang}
  canonicalPath={canonicalPath}
  faqs={t.uuidV5Generator.faqs}
  showPopularTools={true}
  showDefaultEducational={false}
  breadcrumbs={[
    { name: t.site.name, url: 'https://fastuuidgenerator.com/' },
    { name: t.nav.uuidV5, url: `https://fastuuidgenerator.com${canonicalPath}` },
  ]}
>
  <UuidV5Generator t={t} lang={lang} />
</ToolLayout>
