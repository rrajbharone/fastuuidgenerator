---
import { getTranslations } from '../i18n/utils';
import ToolLayout from '../layouts/ToolLayout.astro';
import UuidVersionDetector from '../components/tools/UuidVersionDetector.astro';

const lang = 'en';
const t = getTranslations(lang);
const canonicalPath = '/uuid-version-detector/';
---

<ToolLayout
  title={t.seo.uuidVersionDetectorTitle}
  description={t.seo.uuidVersionDetectorDescription}
  heroTitle={t.uuidVersionDetector.title}
  heroSubtitle={t.uuidVersionDetector.subtitle}
  lang={lang}
  canonicalPath={canonicalPath}
  faqs={t.uuidVersionDetector.faqs}
  showPopularTools={true}
  showDefaultEducational={false}
  breadcrumbs={[
    { name: t.site.name, url: 'https://fastuuidgenerator.com/' },
    { name: t.nav.uuidVersionDetector, url: `https://fastuuidgenerator.com${canonicalPath}` },
  ]}
>
  <UuidVersionDetector t={t} lang={lang} />
</ToolLayout>
