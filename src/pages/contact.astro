---
import LegalLayout from '../layouts/LegalLayout.astro';
---

<LegalLayout
  title="Contact & Developer Feedback"
  description="Get in touch with the FastUUIDGenerator engineering team for bug reports, feature requests, or RFC implementation queries."
  canonicalPath="/contact/"
>
  <h2>Get in Touch</h2>
  <p>
    We welcome feedback, suggestions for new UUID/ULID/KSUID formatting options, and technical inquiries regarding RFC 9562 compliance.
  </p>

  <h2>Developer Channels</h2>
  <ul>
    <li>
      <strong>Email:</strong> <a href="mailto:support@fastuuidgenerator.com">support@fastuuidgenerator.com</a>
    </li>
    <li>
      <strong>GitHub Discussions & Bug Reports:</strong> Available via our official open-source repository.
    </li>
  </ul>

  <h2>Feedback Form</h2>
  <form onsubmit="event.preventDefault(); alert('Thank you for your message! Our engineering team will review it.');" style="margin-top: 1.5rem; display: flex; flex-direction: column; gap: 1rem;">
    <div>
      <label for="contact-name" style="display: block; font-size: 0.85rem; font-weight: 600; margin-bottom: 0.35rem;">Name</label>
      <input type="text" id="contact-name" class="input-control" required placeholder="Your name" />
    </div>

    <div>
      <label for="contact-email" style="display: block; font-size: 0.85rem; font-weight: 600; margin-bottom: 0.35rem;">Email Address</label>
      <input type="email" id="contact-email" class="input-control" required placeholder="you@company.com" />
    </div>

    <div>
      <label for="contact-msg" style="display: block; font-size: 0.85rem; font-weight: 600; margin-bottom: 0.35rem;">Message / Feature Request</label>
      <textarea id="contact-msg" class="textarea-control" rows="5" required placeholder="Tell us how we can improve FastUUIDGenerator..."></textarea>
    </div>

    <div>
      <button type="submit" class="btn btn-primary">Send Feedback</button>
    </div>
  </form>
</LegalLayout>
