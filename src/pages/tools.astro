---
import BaseLayout from '../layouts/BaseLayout.astro';
import PopularTools from '../components/tools/PopularTools.astro';
import { getTranslations } from '../i18n/utils';

const lang = 'en';
const t = getTranslations(lang);
const canonicalPath = '/tools/';
---

<BaseLayout
  title={t.seo.toolsTitle}
  description={t.seo.toolsDescription}
  lang={lang}
  canonicalPath={canonicalPath}
  isMultilingualTool={true}
  showLangSelector={true}
  breadcrumbs={[
    { name: t.site.name, url: 'https://fastuuidgenerator.com/' },
    { name: t.nav.tools, url: `https://fastuuidgenerator.com${canonicalPath}` },
  ]}
>
  <div class="container" style="padding: 2.5rem 1.25rem 4.5rem;">
    <!-- Tools Page Hero Header -->
    <header class="tool-hero" style="text-align: center; max-width: 720px; margin: 0 auto 2.5rem;">
      <span class="badge badge-brand" style="margin-bottom: 0.75rem;">{t.nav.tools}</span>
      <h1 style="font-size: 2.35rem; margin-bottom: 0.75rem; letter-spacing: -0.025em;">
        {t.popularTools.sectionTitle}
      </h1>
      <p style="font-size: 1.05rem; color: var(--text-secondary); line-height: 1.6;">
        {t.popularTools.sectionSubtitle}
      </p>
    </header>

    <!-- All 7 Tools Showcase Grid -->
    <PopularTools lang={lang} t={t} currentPath={canonicalPath} showAll={true} />
  </div>
</BaseLayout>
